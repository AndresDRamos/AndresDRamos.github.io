---
/*
  CV de una hoja. No se ve en pantalla: al imprimir (o guardar como PDF) reemplaza
  al sitio completo. Es el adjunto que acompaña al correo; el detalle vive en la web.
*/
import { content, CONTACT, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang].cv;
const L = c.labels;
const site = (Astro.site ?? new URL("https://andcom.dev")).host;
const gh = CONTACT.github.replace("https://", "");
// El teléfono no vive en el repositorio (es público): se lee de CV_PHONE en un .env local.
// El sitio desplegado no lo define, así que su CV sale sin teléfono.
const phone = import.meta.env.CV_PHONE as string | undefined;
---
<article class="cv" lang={lang}>
  <header>
    <div>
      <h1>Andrés D. Ramos Luna</h1>
      <p class="role">{c.role}</p>
    </div>
    <ul class="contact">
      <li>{CONTACT.email}</li>
      {phone && <li>{phone}</li>}
      <li>{site}</li>
      <li>{gh}</li>
      <li>{CONTACT.city}</li>
    </ul>
  </header>

  <section class="profile">
    <h2>{L.profile}</h2>
    <p>{c.profile}</p>
  </section>

  <div class="cols">
    <div class="main">
      <section>
        <h2>{L.experience}</h2>
        {c.experience.map((e) => (
          <div class="job">
            <div class="jh"><b>{e.role}</b><span>{e.date}</span></div>
            <p class="place">{e.place}</p>
            <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </section>
      <section>
        <h2>{L.systems}</h2>
        <ul class="sys">{c.systems.map((s) => <li><b>{s.t}:</b> {s.d}</li>)}</ul>
      </section>
    </div>

    <aside>
      <section>
        <h2>{L.skills}</h2>
        <ul class="plain">{c.skills.map((s) => <li>{s}</li>)}</ul>
      </section>
      <section>
        <h2>{L.stack}</h2>
        <p class="stack">{c.stack.join(" · ")}</p>
      </section>
      <section>
        <h2>{L.education}</h2>
        {c.education.map((e) => <p class="edu"><b>{e.text}</b><span>{e.date}</span></p>)}
      </section>
      <section>
        <h2>{L.languages}</h2>
        <ul class="plain">{c.languages.map((l) => <li>{l}</li>)}</ul>
      </section>
      <section class="more">
        <h2>{L.more}</h2>
        <p>{site}</p>
      </section>
    </aside>
  </div>
</article>

<style>
  .cv { display: none; }
  @media print {
    .cv { display: block; color: #111; font: 400 10pt/1.48 var(--f-b); }
    header { display: flex; justify-content: space-between; align-items: flex-end; gap: 18pt; padding-bottom: 9pt; border-bottom: 1.5pt solid #111; }
    h1 { font: 600 23pt/1.05 var(--f-d); letter-spacing: -.01em; }
    .role { font: 500 10.5pt/1.3 var(--f-b); color: #9B2C1F; margin-top: 4pt; }
    .contact { list-style: none; margin: 0; padding: 0; text-align: right; font: 400 8.6pt/1.5 var(--f-b); color: #333; }
    h2 { font: 700 7.6pt/1 var(--f-b); letter-spacing: .12em; text-transform: uppercase; color: #9B2C1F; margin: 0 0 5pt; }
    section { margin-top: 15pt; }
    .profile p { font-size: 10.4pt; }
    .cols { display: grid; grid-template-columns: minmax(0, 1fr) 31%; gap: 0 20pt; }
    aside { border-left: .75pt solid #bbb; padding-left: 14pt; margin-top: 15pt; }
    aside section:first-child { margin-top: 0; }
    .job { break-inside: avoid; }
    .job + .job { margin-top: 11pt; }
    .jh { display: flex; justify-content: space-between; align-items: baseline; gap: 10pt; }
    .jh b { font: 600 10.2pt/1.25 var(--f-b); }
    .jh span { font: 500 8.4pt var(--f-m); color: #444; white-space: nowrap; }
    .place { color: #444; font-size: 8.8pt; margin-bottom: 2pt; }
    ul { margin: 0; padding-left: 11pt; }
    li { margin-top: 1.5pt; }
    li::marker { color: #9B2C1F; }
    .sys { list-style: none; padding: 0; }
    .sys li { margin-top: 2.5pt; }
    .plain { list-style: none; padding: 0; }
    .plain li { margin-top: 2.5pt; }
    .stack { font: 400 8.4pt/1.6 var(--f-m); }
    .edu { display: grid; }
    .edu span { font: 500 8.4pt var(--f-m); color: #444; }
    .more p { font: 500 9pt var(--f-m); }
  }
</style>
