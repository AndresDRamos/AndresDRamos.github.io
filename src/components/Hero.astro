---
import { Image } from "astro:assets";
import portrait from "../assets/img/retrato.png";
import Seal from "./Seal.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].hero;
const sealText = lang === "es" ? "arquitectura de datos · andcom · planeación ·" : "data architecture · andcom · plant planning ·";
---
<section class="panel hero" id="inicio" data-nav>
  <div class="wrap" id="contenido">
    <div class="top">
      <div class="txt">
        <p class="kicker" data-r style="--i:0">{t.kicker}</p>
        <h1 data-r style="--i:1">{t.titleA} <em>{t.titleEm}</em></h1>
        <p class="lead" data-r style="--i:2">{t.lead}</p>
        <p class="body" data-r style="--i:3">{t.body}</p>
        <div class="cta no-print" data-r style="--i:4">
          <a class="btn" href="#arquitectura">{t.ctaPrimary}</a>
          <a class="btn ghost" href="#contacto">{t.ctaSecondary}</a>
        </div>
      </div>
      <div class="portrait" data-r="s" style="--i:2">
        <Image src={portrait} alt={t.portraitAlt} widths={[280, 420, 640, 840]} sizes="(max-width: 900px) 40vw, 420px" loading="eager" fetchpriority="high" />
        <Seal uid="hero" text={sealText} class="hero-seal" />
      </div>
    </div>
    <ul class="pillars rail" data-r style="--i:5">
      {t.pillars.map((p, i) => (
        <li><span class="n">0{i + 1}</span><b>{p.k}</b><span>{p.t}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .top { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 96px); align-items: center; }
  .txt { display: grid; gap: clamp(12px, 2.2vh, 22px); justify-items: start; }
  h1 { font-size: min(clamp(2.2rem, .8rem + 3.5vw, 5rem), 9.2vh + 1rem); line-height: 1.04; letter-spacing: -.025em; }
  h1 em { color: var(--seal); font-weight: 500; }
  .lead { font: 600 clamp(1.1rem, .95rem + .6vw, 1.45rem)/1.35 var(--f-b); max-width: 44ch; }
  .body { color: var(--muted); max-width: 62ch; }
  .cta { margin-top: 6px; }
  .portrait { position: relative; justify-self: center; width: min(100%, 420px, 44vh); aspect-ratio: 1; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; filter: grayscale(1) contrast(1.05); display: block; }
  .portrait :global(.hero-seal) { position: absolute; right: -6%; bottom: -6%; width: 44%; }

  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .pillars li { display: grid; gap: 4px; align-content: start; padding: clamp(12px, 2vh, 20px) clamp(14px, 1.6vw, 26px) 0; border-left: 1px solid var(--rule); }
  .pillars li:first-child { border-left: 0; padding-left: 0; }
  .n { font: 500 .8rem var(--f-m); color: var(--seal); }
  .pillars b { font: 560 clamp(1.15rem, 1rem + .5vw, 1.5rem)/1.15 var(--f-d); }
  .pillars li span:last-child { color: var(--muted); font-size: .95rem; line-height: 1.45; }

  @media (max-width: 900px) {
    /* el retrato baja a miniatura junto al nombre; el titular ocupa todo el ancho */
    .top { grid-template-columns: 76px minmax(0, 1fr); gap: 14px 14px; }
    .txt { display: contents; }
    .txt > * { grid-column: 1 / -1; }
    .txt > .kicker { grid-column: 2; grid-row: 1; align-self: center; }
    .portrait { grid-column: 1; grid-row: 1; width: 76px; }
    .portrait :global(.hero-seal) { display: none; }
    .cta { margin-top: 0; }
    h1 { font-size: clamp(1.9rem, 8.6vw, 2.6rem); }
  }
  @media (max-width: 900px) and (max-height: 760px) { .body { display: none; } }
  @media (max-width: 760px) {
    .pillars { border-top: 0; }
    .pillars li, .pillars li:first-child { border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px 16px; background: var(--paper); }
  }
  @media print { .top { grid-template-columns: 1fr 140px; } h1 { font-size: 26pt; } .portrait { width: 140px; } }
</style>
