---
import { Image } from "astro:assets";
import portrait from "../assets/img/retrato.png";
import Seal from "./Seal.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].hero;
const sealText = lang === "es" ? "datos con evidencia · andcom · planeación auditable ·" : "data with evidence · andcom · auditable planning ·";
---
<header class="hero wrap" id="contenido">
  <div>
    <p class="kicker">{t.kicker}</p>
    <div class="dim" aria-hidden="true"><span>{t.dim}</span></div>
    <h1>{t.titleA} <em>{t.titleEm}</em></h1>
    <div class="byline">
      <b>{t.lead}</b>
      <p>{t.body}</p>
    </div>
    <div class="cta no-print">
      <a class="btn" href="#contacto">{t.ctaPrimary}</a>
      <a class="btn ghost" href="#expedientes">{t.ctaSecondary}</a>
    </div>
  </div>
  <div class="portrait">
    <Image src={portrait} alt={t.portraitAlt} widths={[280, 420, 640]} sizes="(max-width: 900px) 70vw, 360px" loading="eager" fetchpriority="high" />
    <Seal uid="hero" text={sealText} class="hero-seal" />
  </div>
</header>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 48px; padding-top: 64px; padding-bottom: 56px; align-items: center; }
  /* cota: guiño al plano técnico */
  .dim { position: relative; height: 18px; margin: 18px 0 14px; max-width: 380px; }
  .dim::before { content: ""; position: absolute; left: 0; right: 0; top: 8px; border-top: 1px solid var(--seal); }
  .dim::after { content: ""; position: absolute; left: 0; right: 0; top: 2px; height: 13px; border-left: 1px solid var(--seal); border-right: 1px solid var(--seal); }
  .dim span { position: absolute; left: 50%; top: -3px; transform: translateX(-50%); background: var(--bg); padding: 0 8px;
    font: 500 .68rem var(--f-m); color: var(--seal); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  h1 { font-size: clamp(2.8rem, 7vw, 5.6rem); line-height: .98; }
  h1 em { color: var(--seal); }
  .byline { margin-top: 28px; display: grid; gap: 6px; max-width: 58ch; }
  .byline b { font: 600 1.05rem var(--f-b); }
  .byline p { color: var(--muted); }
  .cta { margin-top: 30px; }
  .portrait { position: relative; justify-self: center; width: min(100%, 360px); aspect-ratio: 1; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; filter: grayscale(1) contrast(1.05); display: block; }
  .portrait :global(.hero-seal) { position: absolute; right: -6%; bottom: -6%; width: 46%; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 40px; }
    .portrait { width: min(70%, 300px); justify-self: start; grid-row: 1; }
  }
  @media print { .hero { padding-top: 0; grid-template-columns: 1fr 140px; gap: 20px; } h1 { font-size: 30pt; } .portrait { width: 140px; } }
</style>
