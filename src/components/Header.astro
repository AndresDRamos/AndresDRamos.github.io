---
/*
  Encabezado fijo y navegador principal: el sitio no se desplaza, cada enlace
  cambia la sección que ocupa la pantalla. En pantallas angostas es un menú
  desplegable. Aquí vive el enrutador de paneles.
*/
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
---
<header class="hdr no-print" id="hdr">
  <div class="wrap bar">
    <a class="brand" href="#inicio" aria-label="andcom">
      <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M16 0v4M16 28v4M0 16h4M28 16h4" stroke="currentColor" stroke-width="1.2"/><path d="M10 16.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>andcom</span>
    </a>
    <nav id="nav" aria-label={t.ui.sections}>
      {t.nav.map((n) => <a href={`#${n.id}`} data-to={n.id}>{n.label}</a>)}
    </nav>
    <div class="tools">
      <a class="tog" href={t.ui.langHref} hreflang={lang === "es" ? "en" : "es"} lang={lang === "es" ? "en" : "es"}>{t.ui.langSwitch}</a>
      <button class="tog" id="theme" type="button" aria-label={t.ui.theme}>◐</button>
      <button class="tog burger" id="burger" type="button" aria-expanded="false" aria-controls="nav">{t.ui.menu}</button>
    </div>
  </div>
  <span class="prog" aria-hidden="true"></span>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 60; height: var(--hdr);
    background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--rule); }
  .bar { height: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(12px, 2vw, 32px); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 600 1.4rem/1 var(--f-d); letter-spacing: -.01em; }
  .brand svg { width: 28px; height: 28px; color: var(--seal); }
  nav { display: flex; justify-content: center; gap: clamp(2px, .8vw, 10px); }
  nav a { position: relative; text-decoration: none; font: 500 .95rem/1 var(--f-b); color: var(--muted); padding: 10px clamp(8px, 1vw, 14px); border-radius: 999px; transition: color .2s, background .2s; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="true"] { color: var(--ink); background: var(--mark); }
  .tools { display: flex; gap: 8px; }
  .tog { font: 600 .82rem/1.2 var(--f-b); letter-spacing: .04em; background: transparent; color: var(--ink);
    border: 1px solid var(--rule); border-radius: 999px; padding: 8px 13px; cursor: pointer; text-decoration: none; }
  .tog:hover { border-color: var(--ink); }
  .burger { display: none; }
  /* posición dentro del recorrido de secciones */
  .prog { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--seal); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform .6s cubic-bezier(.2, .7, .2, 1); }

  @media (max-width: 980px) {
    .bar { grid-template-columns: 1fr auto; }
    .burger { display: inline-block; }
    .burger[aria-expanded="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    nav { position: fixed; inset: var(--hdr) 0 auto 0; flex-direction: column; gap: 0; padding: 8px var(--gutter) 20px;
      background: var(--bg); border-bottom: 1px solid var(--rule); box-shadow: 0 24px 40px -24px rgba(0, 0, 0, .35);
      opacity: 0; visibility: hidden; transform: translateY(-10px); transition: opacity .25s, transform .25s, visibility .25s; }
    .hdr.open nav { opacity: 1; visibility: visible; transform: none; }
    nav a { font: 560 1.5rem/1.2 var(--f-d); color: var(--ink); padding: 14px 0; border-radius: 0; border-bottom: 1px solid var(--rule); }
    nav a[aria-current="true"] { background: none; color: var(--seal); }
  }
</style>

<script>
  const root = document.documentElement;
  const hdr = document.getElementById("hdr")!;

  /* tema */
  document.getElementById("theme")?.addEventListener("click", () => {
    const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    const next = dark ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch (_) {}
  });

  /* menú en pantallas angostas */
  const burger = document.getElementById("burger")!;
  const setMenu = (open: boolean) => { hdr.classList.toggle("open", open); burger.setAttribute("aria-expanded", String(open)); };
  burger.addEventListener("click", () => setMenu(!hdr.classList.contains("open")));
  hdr.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });

  /* ── enrutador de paneles: el encabezado decide qué sección ocupa la pantalla ── */
  const panels = [...document.querySelectorAll<HTMLElement>("[data-nav]")];
  const links = new Map([...hdr.querySelectorAll<HTMLAnchorElement>("nav a")].map((a) => [a.dataset.to!, a]));
  let cur = -1;
  function go(i: number, updateHash = true) {
    if (i < 0 || i >= panels.length || i === cur) return;
    cur = i;
    panels.forEach((p, k) => {
      p.classList.toggle("active", k === i);
      p.classList.toggle("past", k < i);
      p.toggleAttribute("inert", k !== i);
    });
    panels[i].scrollTop = 0;
    links.forEach((a, id) => id === panels[i].id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current"));
    hdr.style.setProperty("--p", String((i + 1) / panels.length));
    if (updateHash) history.replaceState(null, "", i === 0 ? location.pathname : `#${panels[i].id}`);
  }
  const indexOf = (hash: string) => panels.findIndex((p) => `#${p.id}` === hash);
  go(Math.max(0, indexOf(location.hash)), false);
  addEventListener("hashchange", () => { const i = indexOf(location.hash); if (i >= 0) go(i, false); });

  /* cualquier enlace interno a una sección cambia de panel en vez de desplazar */
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!a) return;
    const i = indexOf(a.getAttribute("href")!);
    if (i < 0) return;
    e.preventDefault();
    go(i);
  });

  /* teclado: flechas izquierda y derecha recorren las secciones */
  addEventListener("keydown", (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
    const el = e.target as HTMLElement;
    if (el.closest('[role="tab"], input, textarea, dialog')) return;
    if (e.key === "ArrowRight" || e.key === "PageDown") go(cur + 1);
    else if (e.key === "ArrowLeft" || e.key === "PageUp") go(cur - 1);
  });
</script>
