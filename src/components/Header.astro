---
/*
  Encabezado fijo y navegador principal: el sitio no se desplaza, cada enlace
  cambia la sección que ocupa la pantalla. En pantallas angostas es un menú
  desplegable y la página se desplaza normal. Aquí vive el enrutador de paneles
  (enlaces, flechas, rueda y botones de anterior/siguiente) y, en celular, el
  seguimiento del scroll.
*/
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
---
<header class="hdr no-print" id="hdr">
  <div class="wrap bar">
    <a class="brand" href="#inicio" aria-label="andcom">
      <!-- símbolo «Joya» (bocetos/logo): la «a» es la red, el rombo es la sinapsis -->
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="joya-hdr" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color:var(--j0)" /><stop offset=".35" style="stop-color:var(--j1)" />
            <stop offset=".7" style="stop-color:var(--j2)" /><stop offset="1" style="stop-color:var(--j3)" />
          </linearGradient>
        </defs>
        <path fill="currentColor" d="M8.75 4.25 L19.725 4.25 L26.75 11.275 L26.75 22 L23.25 18.5 L23.25 17.75 L11.725 17.75 L8.75 20.725 L8.75 21.275 L11.725 24.25 L17.5 24.25 L21 27.75 L10.275 27.75 L5.25 22.725 L5.25 19.275 L10.275 14.25 L23.25 14.25 L23.25 12.725 L18.275 7.75 L5.25 7.75Z" />
        <path class="joya" id="joya" fill="url(#joya-hdr)" d="M22.5 19.25 L26.75 23.5 L22.5 27.75 L18.25 23.5Z" />
      </svg>
      <span>andcom</span>
    </a>
    <nav id="nav" aria-label={t.ui.sections}>
      {t.nav.map((n) => <a href={`#${n.id}`} data-to={n.id}>{n.label}</a>)}
      <!-- en celular no cabe en la barra: vive dentro del menú -->
      <button class="pausa-m" type="button" data-pausa aria-pressed="false"><span class="ico" aria-hidden="true"></span>{t.ui.pause}</button>
    </nav>
    <div class="tools">
      <a class="tog" href={t.ui.langHref} hreflang={lang === "es" ? "en" : "es"} lang={lang === "es" ? "en" : "es"}>{t.ui.langSwitch}<span class="sr-only"> · {t.ui.langName}</span></a>
      <button class="tog" id="pausa" type="button" data-pausa aria-label={t.ui.pause} aria-pressed="false"><span class="ico" aria-hidden="true"></span></button>
      <button class="tog" id="theme" type="button" aria-label={t.ui.theme} aria-pressed="false">◐</button>
      <button class="tog burger" id="burger" type="button" aria-expanded="false" aria-controls="nav" data-abrir={t.ui.menu} data-cerrar={t.ui.closeMenu}>{t.ui.menu}</button>
    </div>
  </div>
  <span class="prog" aria-hidden="true"></span>
</header>

<p class="sr-only no-print" id="aviso-panel" aria-live="polite"></p>
<p class="pista no-print" id="pista" aria-hidden="true"><i></i>{t.ui.swipe}</p>
<div class="pager no-print" id="pager">
  <button type="button" id="prev" aria-label={t.ui.prev}>←</button>
  <span class="pos" id="pos" aria-hidden="true">01 / 08</span>
  <button type="button" id="next" class="nx"><span class="lbl">{t.ui.next}</span> <b id="next-name"></b> →</button>
</div>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 60; height: var(--hdr);
    background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line); }
  .bar { height: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(12px, 2vw, 32px); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 800 1.2rem/1 var(--f-b); letter-spacing: -.02em; }
  .brand svg { width: 30px; height: 30px; overflow: visible; }
  .joya { transform-box: fill-box; transform-origin: center; transition: transform .5s cubic-bezier(.2, .8, .2, 1), filter .5s; }
  :global(.joya.late) { transform: scale(1.3); filter: brightness(1.35); transition-duration: .12s; }
  nav { display: flex; justify-content: center; gap: clamp(2px, 1.2vw, 18px); }
  nav a { position: relative; text-decoration: none; font: 500 .74rem/1 var(--f-m); letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); padding: 10px 4px; transition: color .2s; }
  nav a::after { content: ""; position: absolute; left: 4px; right: 4px; bottom: 2px; height: 2px; background: var(--acc); transform: scaleX(0); transform-origin: left; transition: transform .3s; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="true"] { color: var(--ink); }
  nav a[aria-current="true"]::after { transform: none; }
  .tools { display: flex; gap: 8px; }
  .tog { font: 500 .75rem/1.2 var(--f-m); letter-spacing: .06em; background: transparent; color: var(--ink);
    border: 1px solid var(--line); padding: 8px 12px; cursor: pointer; text-decoration: none; }
  .tog:hover { border-color: var(--acc); }
  .tog[aria-pressed="true"] { border-color: var(--acc); color: var(--acc); }
  [data-pausa] .ico { display: block; flex: none; width: 10px; height: 11px; border-inline: 3px solid currentColor; }
  [data-pausa][aria-pressed="true"] .ico { width: 0; height: 0; border-block: 6px solid transparent; border-inline: 10px solid currentColor; border-right: 0; }
  .pausa-m { display: none; }
  .burger { display: none; }
  .prog { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--acc); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform .6s cubic-bezier(.2, .7, .2, 1); }

  /* anterior / siguiente: sustituye al scroll */
  .pager { position: fixed; right: var(--gutter); bottom: 18px; z-index: 50; display: flex; align-items: stretch; gap: 6px; font: 500 .74rem/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; }
  .pager button { background: color-mix(in srgb, var(--bg2) 85%, transparent); color: var(--ink); border: 1px solid var(--line); padding: 10px 14px; cursor: pointer; font: inherit; letter-spacing: inherit; text-transform: inherit; }
  .pager button:hover { border-color: var(--acc); color: var(--acc); }
  .pager button[disabled] { opacity: .35; cursor: default; }
  .pager .nx { text-align: right; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%); }
  .pager .nx b { font-weight: 500; color: var(--acc); }
  .pos { display: grid; place-items: center; padding: 0 8px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .pager.end .nx { visibility: hidden; } /* ocupa su lugar: los otros botones no se recorren */
  /* sin JS la página se desplaza normal: no hay anterior / siguiente */
  :global(html:not(.paneles)) .pager { display: none; }
  /* en celular se cambia deslizando: los botones no se ven, pero siguen ahí
     para lector de pantalla y teclado (aparecen al enfocarlos) */
  :global(html.movil) .pager:not(:focus-within) { position: fixed; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  /* pista de «desliza» en la portada, hasta el primer cambio */
  .pista { display: none; }
  :global(html.movil) .pista:not([hidden]) { position: fixed; z-index: 40; left: 50%; bottom: max(14px, env(safe-area-inset-bottom)); transform: translateX(-50%);
    display: grid; justify-items: center; gap: 2px; pointer-events: none; font: 500 .75rem/1 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .pista i { width: 10px; height: 10px; border: solid var(--acc); border-width: 2px 0 0 2px; transform: rotate(45deg); animation: pista 1.6s ease-in-out infinite; }
  @keyframes pista { 0%, 100% { translate: 0 4px; opacity: .5; } 50% { translate: 0 -4px; opacity: 1; } }

  @media (max-width: 1100px) {
    .bar { grid-template-columns: 1fr auto; }
    .burger { display: inline-block; min-width: 9ch; } /* cabe «Menú» y «Cerrar» sin que la barra brinque */
    .burger[aria-expanded="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    nav { position: fixed; inset: var(--hdr) 0 auto 0; flex-direction: column; gap: 0; padding: 8px var(--gutter) 20px;
      height: calc(100dvh - var(--hdr)); overflow-y: auto; overscroll-behavior: contain; /* todo el alto: la página no asoma debajo */
      background: var(--bg); border-bottom: 1px solid var(--line);
      opacity: 0; visibility: hidden; transform: translateY(-10px); transition: opacity .25s, transform .25s, visibility .25s; }
    :global(.hdr.open) nav { opacity: 1; visibility: visible; transform: none; transition: opacity .25s, transform .25s, visibility 0s; } /* visible de inmediato: así acepta el foco */
    nav a { font: 600 1.4rem/1.2 var(--f-b); letter-spacing: -.02em; text-transform: none; color: var(--ink); padding: 14px 0; border-bottom: 1px solid var(--line); }
    nav a::after { display: none; }
    nav a[aria-current="true"] { color: var(--acc); }
  }
  @media (max-width: 760px) {
    #pausa { display: none; }
    .pausa-m { display: flex; align-items: center; gap: 12px; min-height: 52px; margin-top: 8px; padding: 0; background: none; border: 0; cursor: pointer;
      font: 500 .8rem/1.2 var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
    .pausa-m[aria-pressed="true"] { color: var(--acc); }
    /* objetivos táctiles de al menos 44 × 44 px */
    .tools { gap: 6px; }
    .tog { min-width: 44px; min-height: 44px; display: inline-grid; place-items: center; padding: 0 12px; }
    nav a { min-height: 52px; display: flex; align-items: center; }
    .pager { left: var(--gutter); right: var(--gutter); bottom: 10px; }
    .pager .nx { flex: 1; justify-content: flex-end; }
    .pager .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } /* el lector sigue oyendo «Siguiente» */
  }
  /* teléfonos muy angostos (320 px): el nombre se vuelve solo el símbolo (aria-label conserva «andcom») */
  @media (max-width: 359px) { .brand span { display: none; } }
</style>

<script>
  const root = document.documentElement;
  const hdr = document.getElementById("hdr")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  /* tema: el botón dice si el tema oscuro está activo (aria-pressed) */
  const temaBtn = document.getElementById("theme")!;
  const oscuro = () => root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  const pintarTema = () => temaBtn.setAttribute("aria-pressed", String(oscuro()));
  pintarTema();
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", pintarTema);
  temaBtn.addEventListener("click", () => {
    const next = oscuro() ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch (_) {}
    pintarTema();
  });

  /* pausar animaciones (WCAG 2.2.2): html.pausa congela todo lo que se mueve solo;
     se recuerda entre visitas. Base.astro la aplica antes de pintar. */
  const pausaBtns = document.querySelectorAll<HTMLElement>("[data-pausa]");
  const pintarPausa = () => pausaBtns.forEach((b) => b.setAttribute("aria-pressed", String(root.classList.contains("pausa"))));
  pintarPausa();
  pausaBtns.forEach((b) => b.addEventListener("click", () => {
    const on = !root.classList.contains("pausa");
    root.classList.toggle("pausa", on);
    try { localStorage.setItem("pausa", on ? "1" : "0"); } catch (_) {}
    pintarPausa();
  }));

  /* menú en pantallas angostas: se cierra con Escape (el foco vuelve al botón),
     al elegir una sección o al tocar fuera */
  const burger = document.getElementById("burger")!;
  const abierto = () => hdr.classList.contains("open");
  const setMenu = (open: boolean, devolverFoco = false) => {
    hdr.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.textContent = (open ? burger.dataset.cerrar : burger.dataset.abrir) ?? "";
    if (!open && devolverFoco) burger.focus();
  };
  const navEl = document.getElementById("nav")!;
  burger.addEventListener("click", () => {
    const open = !abierto();
    setMenu(open);
    /* el menú se vuelve visible en el siguiente cuadro: ahí ya acepta el foco */
    if (open) requestAnimationFrame(() => navEl.querySelector<HTMLElement>("a")?.focus({ preventScroll: true }));
  });
  hdr.addEventListener("focusout", (e) => { if (abierto() && !hdr.contains(e.relatedTarget as Node | null) && e.relatedTarget) setMenu(false); });
  hdr.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  addEventListener("keydown", (e) => { if (e.key === "Escape" && abierto()) setMenu(false, true); });
  document.addEventListener("pointerdown", (e) => { if (abierto() && !hdr.contains(e.target as Node)) setMenu(false); });

  /* ── enrutador de paneles ──
     El sitio es una sola pantalla: el encabezado decide qué sección la ocupa.
     En escritorio se cambia con menú, flechas, rueda o anterior/siguiente.
     En celular (.movil) se cambia deslizando el dedo hacia arriba o abajo; un
     panel puede partirse en subpantallas ([data-sub]) que se recorren antes de
     pasar a la siguiente sección. */
  const mqMovil = matchMedia("(max-width: 760px), (max-height: 500px)");
  const movil = () => root.classList.contains("movil");

  const panels = [...document.querySelectorAll<HTMLElement>("[data-nav]")];
  const links = new Map([...hdr.querySelectorAll<HTMLAnchorElement>("nav a")].map((a) => [a.dataset.to!, a]));
  const pager = document.getElementById("pager")!;
  const prev = document.getElementById("prev") as HTMLButtonElement;
  const next = document.getElementById("next") as HTMLButtonElement;
  const nextName = document.getElementById("next-name")!;
  const pos = document.getElementById("pos")!;
  const avisoPanel = document.getElementById("aviso-panel")!;
  const pista = document.getElementById("pista");
  const main = document.querySelector("main");
  const pad = (n: number) => String(n).padStart(2, "0");
  let cur = -1, sub = 0;
  /* «Siguiente» mide siempre lo del nombre más largo: si cambiara de ancho con
     cada panel, el botón (y los de al lado) se recorrería bajo el cursor */
  let anchoSig = 0;
  function fijarSiguiente() {
    if (anchoSig || !next.offsetWidth) return;
    const actual = nextName.textContent;
    next.style.minWidth = "";
    for (const p of panels) { nextName.textContent = p.dataset.title ?? ""; anchoSig = Math.max(anchoSig, next.offsetWidth); }
    nextName.textContent = actual;
    next.style.minWidth = `${anchoSig}px`;
  }
  const remedir = () => { anchoSig = 0; fijarSiguiente(); };
  addEventListener("resize", remedir);
  document.fonts?.ready.then(remedir);

  /* subpantallas: solo existen en celular */
  const subsDe = (p?: HTMLElement) => (p && movil() ? [...p.querySelectorAll<HTMLElement>("[data-sub]")] : []);
  function mostrarSub(k: number, atras = false) {
    const p = panels[cur], subs = subsDe(p);
    sub = subs.length ? Math.max(0, Math.min(k, subs.length - 1)) : 0;
    subs.forEach((el, j) => { el.classList.toggle("sub-on", j === sub); el.classList.toggle("atras", j === sub && atras); });
    p.scrollTop = 0;
    const total = Math.max(1, subs.length);
    prev.disabled = cur === 0 && sub === 0;
    if (pista && (cur > 0 || sub > 0)) pista.hidden = true; /* la pista solo acompaña la primera pantalla */
    hdr.style.setProperty("--p", String((cur + (sub + 1) / total) / panels.length));
    document.dispatchEvent(new CustomEvent("sub", { detail: { id: p.id, sub } }));
    cerrarDefs();
    if (subs.length) avisoPanel.textContent = `${p.dataset.title ?? ""} · ${sub + 1} / ${subs.length}`;
    marcarMas();
    setTimeout(marcarMas, 500); /* de nuevo cuando acabe la animación de entrada */
  }

  function go(i: number, updateHash = true, subInicial = 0) {
    if (i < 0 || i >= panels.length) return;
    if (i === cur) { if (subInicial !== sub) mostrarSub(subInicial, subInicial < sub); return; }
    const first = cur === -1;
    const atras = !first && i < cur;
    /* dentro de un mismo grupo (las etapas del método) no se cambia de página:
       solo entran los textos nuevos; ver .mismo en global.css */
    const g = panels[i].dataset.grupo;
    const mismo = !first && !!g && panels[cur]?.dataset.grupo === g;
    main?.classList.toggle("mismo", mismo);
    cur = i;
    panels.forEach((p, k) => {
      p.classList.toggle("active", k === i);
      p.classList.toggle("past", k < i);
      p.toggleAttribute("inert", k !== i);
      p.classList.remove("glitch-in");
    });
    const p = panels[i];
    p.scrollTop = 0;
    mostrarSub(subInicial, atras);
    /* sin glitch dentro del mismo grupo: el título que se acaba de pulsar no se sacude */
    if (!first && !mismo && !reduce.matches) { void p.offsetWidth; p.classList.add("glitch-in"); }
    /* el lector de pantalla oye a qué panel llegó (el foco se queda en el control) */
    if (!first && !subsDe(p).length) avisoPanel.textContent = p.dataset.title ?? "";
    /* «Siguiente» se oculta en el último panel: si tenía el foco, pasa a «Anterior» */
    if (i === panels.length - 1 && document.activeElement === next) prev.focus();
    pager.classList.toggle("end", i === panels.length - 1);
    nextName.textContent = panels[i + 1]?.dataset.title ?? "";
    pos.textContent = `${pad(i + 1)} / ${pad(panels.length)}`;
    fijarSiguiente();
    /* marca la sección en el menú (el panel de arquitectura y las etapas del
       método marcan a su «padre») y avisa a quien escuche (la portada pausa su
       animación cuando no se ve) */
    const navId = p.dataset.parent ?? p.id;
    links.forEach((a, id) => id === navId ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current"));
    document.dispatchEvent(new CustomEvent("panel", { detail: p.id }));
    cerrarDefs();
    if (updateHash) history.replaceState(null, "", i === 0 ? location.pathname : `#${p.id}`);
  }
  /* un paso adelante o atrás: primero las subpantallas del panel, luego el panel */
  function paso(dir: 1 | -1) {
    const n = subsDe(panels[cur]).length;
    if (n && sub + dir >= 0 && sub + dir < n) { mostrarSub(sub + dir, dir < 0); return; }
    const j = cur + dir;
    if (j < 0 || j >= panels.length) {
      const p = panels[cur];
      if (!movil() || reduce.matches) return;
      p.style.setProperty("--tope", dir > 0 ? "-14px" : "14px");
      p.classList.remove("tope"); void p.offsetWidth; p.classList.add("tope");
      return;
    }
    go(j, true, dir < 0 ? Math.max(0, subsDe(panels[j]).length - 1) : 0);
  }
  const indexOf = (hash: string) => panels.findIndex((p) => `#${p.id}` === hash);

  /* el tamaño de la ventana puede cruzar el límite celular/escritorio */
  mqMovil.addEventListener("change", () => {
    root.classList.toggle("movil", mqMovil.matches);
    setMenu(false);
    if (cur >= 0) mostrarSub(0);
  });

  /* el contenedor de paneles nunca se desplaza: al llegar por una liga (#seccion)
     el navegador intenta llevar el panel a la vista y movía todo unos px */
  main?.addEventListener("scroll", () => { if (main.scrollTop || main.scrollLeft) main.scrollTo(0, 0); });
  go(Math.max(0, indexOf(location.hash)), false);
  addEventListener("hashchange", () => { const i = indexOf(location.hash); if (i >= 0) go(i, false); });
  prev.addEventListener("click", () => paso(-1));
  next.addEventListener("click", () => paso(1));

  /* cualquier enlace interno a una sección cambia de panel en vez de desplazar */
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!a) return;
    const i = indexOf(a.getAttribute("href")!);
    if (i < 0) return;
    e.preventDefault();
    go(i);
  });

  /* teclado: flechas recorren las secciones (y subpantallas) */
  addEventListener("keydown", (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
    const el = e.target as HTMLElement;
    if (el.closest('[role="tab"], input, textarea, dialog')) return;
    if (e.key === "ArrowRight" || e.key === "PageDown") paso(1);
    else if (e.key === "ArrowLeft" || e.key === "PageUp") paso(-1);
    else if (movil() && (e.key === "ArrowDown" || e.key === "ArrowUp")) {
      const down = e.key === "ArrowDown";
      if (!puedeDesplazar(down)) { e.preventDefault(); paso(down ? 1 : -1); }
    }
  });

  /* flecha «hay más abajo» mientras el panel en curso tenga contenido sin ver */
  function marcarMas() {
    const p = panels[cur];
    if (!p) return;
    p.classList.toggle("mas", movil() && p.scrollTop + p.clientHeight < p.scrollHeight - 8);
  }
  panels.forEach((p) => {
    p.addEventListener("scroll", marcarMas, { passive: true });
    p.addEventListener("animationend", (e) => { if (e.animationName === "tope") p.classList.remove("tope"); });
  });
  addEventListener("resize", marcarMas);

  /* ¿el panel aún puede desplazarse en esa dirección? (pantallas muy bajas) */
  const puedeDesplazar = (down: boolean) => {
    const p = panels[cur];
    return down ? p.scrollTop + p.clientHeight < p.scrollHeight - 2 : p.scrollTop > 2;
  };

  /* rueda o trackpad: un gesto = un paso. Si el panel tiene contenido que aún
     puede desplazarse, primero se desplaza ese contenido. */
  let lock = 0, acc = 0;
  addEventListener("wheel", (e) => {
    if (Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
    const down = e.deltaY > 0;
    if (puedeDesplazar(down)) return;
    const now = performance.now();
    if (now < lock) return;
    acc += e.deltaY;
    if (Math.abs(acc) < 40) return;
    acc = 0; lock = now + 900;
    paso(down ? 1 : -1);
  }, { passive: true });

  /* celular: deslizar el dedo hacia arriba = siguiente; hacia abajo = anterior.
     Se ignora si el gesto es más horizontal que vertical, si empezó dentro de un
     carrusel o de un diálogo, o si el panel aún tenía contenido por desplazar
     (en ese caso el dedo desplaza el contenido, como siempre). */
  let ty = 0, tx = 0, tt = 0, desplazable = false, arriba = true, abajo = true, multi = false;
  /* la animación de entrada de una subpantalla agranda un instante el área
     desplazable: eso no cuenta como «tiene más contenido» */
  const animando = (p: HTMLElement) => p.getAnimations({ subtree: true }).some((a) => a.playState === "running" && /^sub-in/.test((a as CSSAnimation).animationName ?? ""));
  addEventListener("touchstart", (e) => {
    /* dos dedos (pellizcar para ampliar) anulan el gesto hasta que se levanten todos */
    if (e.touches.length > 1) { multi = true; return; }
    multi = false;
    ty = e.touches[0].clientY; tx = e.touches[0].clientX; tt = performance.now();
    const p = panels[cur];
    if (!p) return;
    desplazable = p.scrollHeight > p.clientHeight + 2 && !animando(p);
    arriba = p.scrollTop <= 2;
    abajo = p.scrollTop + p.clientHeight >= p.scrollHeight - 2;
  }, { passive: true });
  addEventListener("touchcancel", () => { multi = true; }, { passive: true });
  addEventListener("touchend", (e) => {
    if (multi) { if (e.touches.length === 0) multi = false; return; }
    if (abierto() || e.changedTouches.length !== 1) return;
    /* con la página ampliada, el dedo sirve para recorrerla, no para cambiar de pantalla */
    if ((window.visualViewport?.scale ?? 1) > 1.01) return;
    const t = e.target as HTMLElement;
    if (t.closest(".rail, dialog, [data-sin-gesto]")) return;
    const dy = ty - e.changedTouches[0].clientY, dx = tx - e.changedTouches[0].clientX;
    const rapido = performance.now() - tt < 600;
    if (Math.abs(dy) < (rapido ? 40 : 80) || Math.abs(dy) < Math.abs(dx) * 1.3) return;
    const down = dy > 0;
    /* si el panel se desplaza, solo cambia cuando el gesto empezó ya en el borde */
    if (desplazable && !(down ? abajo : arriba)) return;
    paso(down ? 1 : -1);
  }, { passive: true });

  /* definiciones del glosario (terminos.ts): se abren al tocar o con Enter y se
     cierran con Escape o tocando fuera. Al abrirse (también con cursor o foco)
     se colocan donde quepan: hacia abajo si arriba no hay espacio y recorridas
     de lado para no salirse de la pantalla. */
  const colocar = (w: HTMLElement) => {
    const def = w.querySelector<HTMLElement>(".def");
    if (!def) return;
    const r = w.getBoundingClientRect(), m = 12;
    w.classList.toggle("abajo", r.top < 170);
    /* se calcula antes de que se pinte (y aunque aún no se vea) para que nunca
       ensanche la página: ancho = el de la regla CSS, min(300px, 100vw - márgenes) */
    const ancho = def.offsetWidth || Math.min(300, innerWidth - 2 * m);
    const dx = r.left + ancho > innerWidth - m ? innerWidth - m - (r.left + ancho) : 0;
    def.style.setProperty("--dx", `${Math.round(Math.max(dx, m - r.left))}px`);
  };
  function cerrarDefs(salvo?: Element | null) {
    document.querySelectorAll<HTMLElement>(".term-w.abierto").forEach((w) => {
      if (w === salvo) return;
      w.classList.remove("abierto");
      w.querySelector(".term")?.setAttribute("aria-expanded", "false");
    });
  }
  /* Safari no manda «click» al tocar texto común: fuera del término se cierra con pointerdown */
  document.addEventListener("pointerdown", (e) => {
    if (!(e.target as HTMLElement).closest(".term-w")) cerrarDefs();
  });
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>(".term");
    const w = b?.parentElement ?? null;
    if (!b || !w) return;
    cerrarDefs(w);
    const open = !w.classList.contains("abierto");
    w.classList.toggle("abierto", open);
    b.setAttribute("aria-expanded", String(open));
    if (open) colocar(w);
  });
  addEventListener("keydown", (e) => { if (e.key === "Escape") cerrarDefs(); });
  const alPasar = (e: Event) => { const w = (e.target as HTMLElement).closest<HTMLElement>(".term-w"); if (w) colocar(w); };
  document.addEventListener("pointerover", alPasar);
  document.addEventListener("focusin", alPasar);
</script>
