---
import { content, CONTACT, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
---
<div class="wrap">
  <div class="mast">
    <a class="brand" href={lang === "es" ? "/" : "/en/"} aria-label="andcom">
      <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M16 0v4M16 28v4M0 16h4M28 16h4" stroke="currentColor" stroke-width="1.2"/><path d="M10 16.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>andcom</span>
    </a>
    <span class="center kicker">{lang === "es" ? "Expediente de consultoría" : "Consulting file"} · Nº 2026-11</span>
    <div class="tools no-print">
      <button class="tog" id="audit" type="button" aria-pressed="false">{t.ui.audit}</button>
      <a class="tog" href={t.ui.langHref} hreflang={lang === "es" ? "en" : "es"} lang={lang === "es" ? "en" : "es"}>{t.ui.langSwitch}</a>
      <button class="tog" id="theme" type="button" aria-label={t.ui.theme}>◐</button>
    </div>
  </div>
  <div class="subbar">
    <nav aria-label={lang === "es" ? "Secciones" : "Sections"} class="no-print">
      {t.nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
    </nav>
    <span>{CONTACT.city} · Supply Chain · {lang === "es" ? "planeación de producción" : "production planning"}</span>
  </div>
</div>

<style>
  .mast { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--ink); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 400 1.6rem/1 var(--f-d); justify-self: start; }
  .brand svg { width: 30px; height: 30px; color: var(--seal); }
  .center { text-align: center; }
  .tools { display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
  .tog { font: 500 .72rem var(--f-m); letter-spacing: .08em; text-transform: uppercase; background: transparent; color: var(--ink);
    border: 1px solid var(--rule); border-radius: 999px; padding: 7px 12px; cursor: pointer; text-decoration: none; line-height: 1.2; }
  .tog:hover { border-color: var(--ink); }
  .tog[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .subbar { display: flex; justify-content: space-between; gap: 8px 18px; padding: 8px 0; border-bottom: 1px solid var(--rule);
    font: 500 .72rem var(--f-m); color: var(--muted); letter-spacing: .06em; flex-wrap: wrap; }
  .subbar nav { display: flex; gap: 6px 18px; flex-wrap: wrap; }
  .subbar a { text-decoration: none; }
  .subbar a:hover { color: var(--seal); }
  @media (max-width: 900px) { .mast { grid-template-columns: 1fr auto; } .center { display: none; } }
</style>

<script>
  const audit = document.getElementById("audit");
  audit?.addEventListener("click", () => {
    const on = document.body.classList.toggle("audit");
    audit.setAttribute("aria-pressed", String(on));
  });
  document.getElementById("theme")?.addEventListener("click", () => {
    const r = document.documentElement;
    const dark = r.dataset.theme ? r.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    const next = dark ? "light" : "dark";
    r.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch (_) {}
  });
</script>
