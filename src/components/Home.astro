---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Arquitectura from "./Arquitectura.astro";
import Sistemas from "./Sistemas.astro";
import Principios from "./Principios.astro";
import Servicios from "./Servicios.astro";
import Trayectoria from "./Trayectoria.astro";
import Contacto from "./Contacto.astro";
import Cv from "./Cv.astro";
import type { Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Arquitectura lang={lang} />
    <Sistemas lang={lang} />
    <Principios lang={lang} />
    <Servicios lang={lang} />
    <Trayectoria lang={lang} />
    <Contacto lang={lang} />
  </main>
  <Cv lang={lang} />
</Base>
