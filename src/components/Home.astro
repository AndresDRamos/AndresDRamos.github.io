---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Cifras from "./Cifras.astro";
import Metodo from "./Metodo.astro";
import Expedientes from "./Expedientes.astro";
import Servicios from "./Servicios.astro";
import Laminas from "./Laminas.astro";
import Revisiones from "./Revisiones.astro";
import Contacto from "./Contacto.astro";
import type { Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Cifras lang={lang} />
    <Metodo lang={lang} />
    <Expedientes lang={lang} />
    <Servicios lang={lang} />
    <Laminas lang={lang} />
    <Revisiones lang={lang} />
    <Contacto lang={lang} />
  </main>
</Base>
