---
/*
  Arquitectura de datos en lenguaje claro: un entregable del gobierno de datos.
  El dato recorre cinco estaciones (nace, viaja, se revisa, se guarda, se usa)
  dentro de un marco de reglas y responsables. Cada estación es un botón: abajo
  se explica qué es, por qué importa, cómo lo hago y cómo se llama en términos
  técnicos (con su definición al pasar el cursor). Sin JS se muestran todas.
*/
import { content, type Lang } from "../i18n/content";
import { marcar } from "../i18n/terminos";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const a = c.arch;
const todas = [...a.stations, a.frame];
const MARCO = a.stations.length;
const mk = (t: string) => marcar(t, c.glossary);
---
<section class="panel arch" id="arquitectura" data-nav data-title={c.ui.panels.arquitectura} style="--lx:50%;--ly:35%">
  <div class="wrap">
    <header class="sec-h" data-r>
      <h2>{a.title}</h2>
      <p>{a.intro}</p>
    </header>

    <div class="mapa" data-r style="--i:1" role="group" aria-label={a.title}>
      <button type="button" class="est marco" data-i={MARCO} aria-pressed="false">
        <span class="tag">{a.frame.tag}</span><b>{a.frame.node}</b><span class="sub">{a.frame.sub}</span>
      </button>
      <div class="ruta">
        {a.stations.map((s, i) => (
          <>
            {i > 0 && <span class="tubo" aria-hidden="true" style={`--d:${i}`}><i></i></span>}
            <button type="button" class:list={["est", `e${i}`]} data-i={i} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="tag">{s.tag}</span>
              <b>{s.node}</b>
              {i === 2 && <span class="sello" aria-hidden="true">✓ ✓</span>}
              {i === 3 && <span class="zonas" aria-hidden="true">{s.sub.split(" · ").map((z) => <i>{z}</i>)}</span>}
              {i !== 3 && <span class="sub">{s.sub}</span>}
            </button>
          </>
        ))}
      </div>
      <p class="pie"><span>{a.hint}</span><span>{a.base}</span></p>
    </div>

    <div class="dets" data-r style="--i:2" aria-live="polite">
      {todas.map((s, i) => (
        <article class:list={["det", { on: i === 0 }]} data-i={i}>
          <div class="col">
            <span class="kicker c-acc">{s.tag}</span>
            <h3>{s.node}</h3>
            <p><b>{a.labels.what}</b><span set:html={mk(s.what)} /></p>
            <p><b>{a.labels.why}</b><span set:html={mk(s.why)} /></p>
          </div>
          <div class="col">
            <b>{a.labels.how}</b>
            <ul>{s.how.map((h) => <li set:html={mk(h)} />)}</ul>
          </div>
          <div class="col">
            <b>{a.labels.tech}</b>
            <div class="chips">{s.tech.map((t) => <span class="chip" set:html={mk(t)} />)}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── mapa del recorrido ── */
  .mapa { position: relative; border: 1.5px dashed color-mix(in srgb, var(--acc) 55%, transparent); padding: 0 clamp(12px, 1.6vw, 24px) 12px; }
  .ruta { display: grid; grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr) 48px minmax(0, 1fr) 48px minmax(0, 1.25fr) 48px minmax(0, 1fr);
    align-items: stretch; margin-top: clamp(12px, 2.4vh, 24px); }
  .est { all: unset; box-sizing: border-box; cursor: pointer; position: relative; z-index: 1; display: grid; align-content: center; justify-items: start; gap: 6px;
    min-height: clamp(110px, 19vh, 170px); padding: 14px clamp(12px, 1.2vw, 18px); background: var(--bg2); border-left: 2px solid var(--line);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
    transition: background .25s, border-color .25s, transform .25s; }
  .est:hover { transform: translateY(-2px); border-left-color: var(--acc); }
  .est:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .est[aria-pressed="true"] { border-left-color: var(--acc); background: color-mix(in srgb, var(--acc) 14%, var(--bg2)); }
  .tag { font: 500 .66rem/1 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--acc); }
  .est b { font: 600 clamp(.95rem, .8rem + .55vw, 1.3rem)/1.1 var(--f-b); letter-spacing: -.02em; }
  .sub { font: 400 .78rem/1.35 var(--f-m); color: var(--muted); }
  .sello { font: 600 .8rem/1 var(--f-m); color: var(--bg); background: var(--acc); padding: 4px 6px; letter-spacing: .1em; }
  .zonas { display: flex; flex-wrap: wrap; gap: 4px; }
  .zonas i { font: 500 .68rem/1 var(--f-m); padding: 5px 6px; border: 1px solid var(--line); background: var(--bg); }
  .zonas i:nth-child(2) { border-color: var(--acc); }

  /* el marco de gobierno */
  .marco { min-height: 0; width: 100%; grid-template-columns: auto auto 1fr; align-items: baseline; gap: 4px 14px; padding: 12px 4px 10px;
    margin-inline: 0; background: none; border-left: 0; border-bottom: 1.5px dashed color-mix(in srgb, var(--acc) 55%, transparent); clip-path: none; }
  .marco:hover { transform: none; }
  .marco[aria-pressed="true"] { background: color-mix(in srgb, var(--acc) 10%, transparent); }

  /* tubos: el dato viaja entre estaciones */
  .tubo { position: relative; align-self: center; height: 2px; margin-inline: 4px; background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 10px); }
  .tubo::after { content: ""; position: absolute; right: -2px; top: -4px; border: 5px solid transparent; border-left: 7px solid var(--line); border-right: 0; }
  .tubo i { position: absolute; top: -3px; left: 0; width: 8px; height: 8px; background: var(--acc); animation: viaja 1.6s linear infinite; animation-delay: calc(var(--d) * .3s); }
  @keyframes viaja { from { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } to { left: calc(100% - 8px); opacity: 0; } }
  .pie { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 10px; font: 500 .7rem/1.3 var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }

  /* ── explicación de la estación elegida ── */
  .dets { display: grid; }
  .det { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, .7fr); gap: clamp(16px, 3vw, 48px); align-items: start; }
  .det + .det { margin-top: 20px; }
  .col { display: grid; gap: 8px; align-content: start; }
  h3 { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.3rem); line-height: 1.04; letter-spacing: -.03em; }
  .col p { display: grid; gap: 2px; font-size: .95rem; line-height: 1.5; color: var(--muted); }
  .col b { display: block; font: 500 .68rem/1.3 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--ink); }
  .col li { position: relative; padding: 7px 0 7px 22px; border-top: 1px solid var(--line); font-size: .95rem; line-height: 1.4; }
  .col li::before { content: "◆"; position: absolute; left: 2px; color: var(--acc); font-size: .65em; top: calc(7px + .45em); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { color: var(--ink); }

  :global(.js) .det { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity .3s, transform .4s cubic-bezier(.2, .7, .2, 1), visibility .3s; }
  :global(.js) .det.on { opacity: 1; visibility: visible; transform: none; }
  :global(.js) .det.on li { animation: li-in .45s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--k, 0) * 60ms + 80ms); }
  @keyframes li-in { from { opacity: 0; transform: translateX(14px); } }

  @media (max-width: 1000px) {
    .ruta { grid-template-columns: 1fr; gap: 0; }
    .tubo { justify-self: start; width: 2px; height: 18px; margin: 0 0 0 20px; background: var(--line); }
    .tubo::after, .tubo i { display: none; }
    .est { min-height: 0; grid-template-columns: auto 1fr; align-items: baseline; gap: 4px 12px; padding: 10px 12px; }
    .est .sub, .zonas, .sello { display: none; }
    .det { grid-template-columns: 1fr; gap: 10px; }
    .det .col:last-child { display: none; }
  }
  @media print {
    .mapa { display: none; }
    .det { opacity: 1 !important; visibility: visible !important; transform: none !important; grid-area: auto !important; }
  }
</style>

<script>
  const arch = document.querySelector<HTMLElement>(".arch");
  if (arch) {
    const ests = [...arch.querySelectorAll<HTMLButtonElement>(".est")];
    const dets = [...arch.querySelectorAll<HTMLElement>(".det")];
    dets.forEach((d) => d.querySelectorAll<HTMLElement>("li").forEach((li, k) => li.style.setProperty("--k", String(k))));
    const pick = (i: number) => {
      ests.forEach((e) => e.setAttribute("aria-pressed", String(Number(e.dataset.i) === i)));
      dets.forEach((d) => d.classList.toggle("on", Number(d.dataset.i) === i));
    };
    ests.forEach((e) => e.addEventListener("click", () => pick(Number(e.dataset.i))));
  }
</script>
