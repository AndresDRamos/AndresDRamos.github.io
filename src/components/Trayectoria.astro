---
/*
  Trayectoria: de la celda robótica a la empresa conectada. A la izquierda la
  línea de tiempo; a la derecha las láminas originales de distribución de celdas.
*/
import { Image } from "astro:assets";
import { content, type Lang } from "../i18n/content";
import l1 from "../assets/img/layout-celda-transportador.png";
import l2 from "../assets/img/layout-celdas-pems.png";
import l3 from "../assets/img/layout-planta.png";
import retrato from "../assets/img/retrato.jpg";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = content[lang].ui;
const c = content[lang].career;
const s = c.sheets;
const imgs: Record<string, ImageMetadata> = { "layout-celda-transportador": l1, "layout-celdas-pems": l2, "layout-planta": l3 };
const last = c.items.length - 1;
---
<section class="panel trayectoria" id="trayectoria" data-nav data-title={ui.panels.trayectoria} style="--lx:25%;--ly:30%">
  <div class="wrap">
    <div class="cols">
      <div class="left">
        <header class="sec-h" data-r>
          <h2>{c.title}</h2>
        </header>
        <div class="quien" data-r style="--i:1">
          <Image src={retrato} alt="Andrés D. Ramos Luna" widths={[160, 320]} sizes="96px" class="foto cut" />
          <p class="origin">{c.origin.lead}<b>{c.origin.em}</b>{c.origin.rest}</p>
        </div>
        <ol class="time rail" data-r style="--i:2">
          {c.items.map((it, i) => (
            <li class:list={{ cur: i === last }}>
              <span class="rev">{it.rev}</span><span class="date">{it.date}</span><span>{it.text}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="right no-print">
        <div class="sheets rail">
          {s.items.map((it, i) => (
            <figure data-r="s" style={`--i:${i + 1}`}>
              <button type="button" class="zoom" data-title={it.title} aria-label={`${it.title} · ${s.hint}`}>
                <Image src={imgs[it.file]} alt={it.alt} widths={[480, 800, 1280]} sizes="(max-width: 900px) 86vw, 520px" data-full={imgs[it.file].src} />
              </button>
              <figcaption><span>{it.title}</span><span>{it.code}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="hint kicker">{s.hint}</p>
      </div>
    </div>
  </div>
  <dialog class="dlg">
    <img alt="" />
    <form method="dialog"><span class="cap"></span><button>{s.close}</button></form>
  </dialog>
</section>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 72px); align-items: stretch; }
  .left { display: grid; gap: clamp(14px, 2.4vh, 26px); align-content: center; }
  .quien { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: center; }
  .quien :global(.foto) { width: clamp(64px, 7vw, 96px); height: clamp(64px, 7vw, 96px); object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .origin { font-size: clamp(1rem, .9rem + .4vw, 1.25rem); line-height: 1.45; }
  .origin b { color: var(--acc); font-weight: 600; }
  .time { border-top: 1px solid var(--line); }
  .time li { display: grid; grid-template-columns: 24px 82px 1fr; gap: 10px; align-items: baseline; padding: clamp(5px, .9vh, 9px) 0; border-bottom: 1px solid var(--line); font-size: .92rem; line-height: 1.4; color: var(--muted); }
  .rev { font: 500 .8rem var(--f-m); color: var(--acc); }
  .date { font: 500 .78rem var(--f-m); white-space: nowrap; }
  .time li.cur { color: var(--ink); }
  .time li.cur .rev { color: var(--sin); }

  .right { position: relative; min-height: 0; }
  .sheets { position: absolute; inset: 0 0 34px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: minmax(0, 1.7fr) minmax(0, 1fr); gap: 12px; min-height: 0; }
  .hint { position: absolute; left: 0; bottom: 0; }
  figure { margin: 0; border: 1px solid var(--line); background: #1B2128; display: grid; grid-template-rows: minmax(0, 1fr) auto; min-height: 0; }
  figure:first-child { grid-column: 1 / -1; }
  .zoom { all: unset; cursor: zoom-in; display: block; overflow: hidden; min-height: 110px; }
  .zoom:focus-visible { outline: 2px solid var(--acc); outline-offset: -2px; }
  .zoom :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
  .zoom:hover :global(img) { transform: scale(1.04); }
  figcaption { display: grid; grid-template-columns: 1fr auto; border-top: 1px solid var(--line); font: 500 .74rem var(--f-m); letter-spacing: .04em; background: var(--bg2); }
  figcaption span { padding: 7px 12px; }
  figcaption span + span { border-left: 1px solid var(--line); color: var(--acc); }
  dialog { border: 1px solid var(--line); background: var(--bg2); color: var(--ink); padding: 0; max-width: min(1200px, 94vw); }
  dialog::backdrop { background: rgba(6, 7, 11, .85); }
  dialog img { display: block; max-width: 100%; max-height: 82vh; }
  dialog form { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 12px; font: 500 .78rem var(--f-m); border-top: 1px solid var(--line); }
  dialog button { font: inherit; background: transparent; color: var(--acc); border: 1px solid var(--acc); padding: 4px 10px; cursor: pointer; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; }
    .right { display: grid; gap: 14px; }
    .sheets { position: static; grid-template-rows: none; }
    figure, figure:first-child { grid-column: auto; }
    .zoom { aspect-ratio: 16 / 10; }
    .hint { position: static; }
  }
  @media (max-width: 760px) {
    .time { border-top: 0; grid-auto-columns: 62% !important; }
    .time li { grid-template-columns: auto 1fr; align-content: start; gap: 4px 8px; padding: 10px 12px; border: 1px solid var(--line); background: var(--bg2); font-size: .88rem; }
    .time li span:last-child { grid-column: 1 / -1; }
    .sheets { grid-auto-columns: 80% !important; }
  }
</style>

<script>
  const tr = document.querySelector<HTMLElement>(".trayectoria");
  if (tr) {
    const dlg = tr.querySelector<HTMLDialogElement>(".dlg")!;
    const dimg = dlg.querySelector("img")!;
    tr.querySelectorAll<HTMLButtonElement>(".zoom").forEach((b) => b.addEventListener("click", () => {
      const img = b.querySelector("img")!;
      dimg.src = img.dataset.full ?? img.currentSrc; dimg.alt = img.alt;
      dlg.querySelector(".cap")!.textContent = b.dataset.title ?? "";
      dlg.showModal();
    }));
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
