---
/*
  Trayectoria: de la celda robótica a la empresa conectada. A la izquierda la
  línea de tiempo; a la derecha las láminas originales de distribución de celdas.
*/
import { Image } from "astro:assets";
import { content, type Lang } from "../i18n/content";
import { trayectoriaMovil } from "../i18n/movil/trayectoria";
import l1 from "../assets/img/layout-celda-transportador.png";
import l2 from "../assets/img/layout-celdas-pems.png";
import l3 from "../assets/img/layout-planta.png";
import retrato from "../assets/img/retrato.jpg";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = content[lang].ui;
const c = content[lang].career;
const s = c.sheets;
const imgs: Record<string, ImageMetadata> = { "layout-celda-transportador": l1, "layout-celdas-pems": l2, "layout-planta": l3 };
const last = c.items.length - 1;
const m = trayectoriaMovil[lang]; /* textos compactos: solo se ven en html.movil */
---
<section class="panel trayectoria" id="trayectoria" data-nav data-title={ui.panels.trayectoria} style="--lx:25%;--ly:30%">
  <div class="wrap">
    <div class="cols">
      <div class="left" data-sub>
        <header class="sec-h" data-r>
          <h2>{c.title}</h2>
        </header>
        <div class="quien" data-r style="--i:1">
          <Image src={retrato} alt="Andrés D. Ramos Luna" widths={[160, 320]} sizes="96px" class="foto cut" />
          <p class="origin"><span class="d">{c.origin.lead}<b>{c.origin.em}</b>{c.origin.rest}</span><span class="m">{m.origin.lead}<b>{m.origin.em}</b>{m.origin.rest}</span></p>
        </div>
        <ol class="time" data-r style="--i:2">
          {c.items.map((it, i) => (
            <li class:list={{ cur: i === last }}>
              <span class="rev">{it.rev}</span><span class="date">{it.date}</span><span><span class="d">{it.text}</span><span class="m">{m.items[i]}</span></span>
            </li>
          ))}
        </ol>
      </div>

      <div class="right no-print" data-sub>
        <h3 class="lam-t kicker c-acc">{m.laminas}</h3>
        <div class="sheets">
          {s.items.map((it, i) => (
            <figure data-r="s" style={`--i:${i + 1}`}>
              <button type="button" class="zoom" data-title={it.title} aria-label={`${it.title} · ${s.hint}`}>
                <Image src={imgs[it.file]} alt={it.alt} widths={[480, 800, 1280]} sizes="(max-width: 900px) 86vw, 520px" data-full={imgs[it.file].src} />
              </button>
              <figcaption><span>{it.title}</span><span>{it.code}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="hint kicker">{s.hint}</p>
      </div>
    </div>
  </div>
  <dialog class="dlg" aria-labelledby="dlg-cap">
    <img alt="" />
    <form method="dialog"><span class="cap" id="dlg-cap"></span><button>{s.close}<span class="esc" aria-hidden="true"> · Esc</span></button></form>
  </dialog>
</section>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 72px); align-items: stretch; }
  .left { display: grid; gap: clamp(14px, 2.4vh, 26px); align-content: center; }
  .quien { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: center; }
  .quien :global(.foto) { width: clamp(64px, 7vw, 96px); height: clamp(64px, 7vw, 96px); object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .origin { font-size: clamp(1rem, .9rem + .4vw, 1.25rem); line-height: 1.45; }
  .origin b { color: var(--acc); font-weight: 600; }
  .time { border-top: 1px solid var(--line); }
  .time li { display: grid; grid-template-columns: 24px 82px 1fr; gap: 10px; align-items: baseline; padding: clamp(5px, .9vh, 9px) 0; border-bottom: 1px solid var(--line); font-size: .92rem; line-height: 1.4; color: var(--muted); }
  .rev { font: 500 .8rem var(--f-m); color: var(--acc); }
  .date { font: 500 .78rem var(--f-m); white-space: nowrap; }
  .time li.cur { color: var(--ink); }
  .time li.cur .rev { color: var(--sin); }

  .right { position: relative; min-height: 0; }
  .sheets { position: absolute; inset: 0 0 34px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: minmax(0, 1.7fr) minmax(0, 1fr); gap: 12px; min-height: 0; }
  .hint { position: absolute; left: 0; bottom: 0; }
  figure { margin: 0; border: 1px solid var(--line); background: #1B2128; display: grid; grid-template-rows: minmax(0, 1fr) auto; min-height: 0; }
  figure:first-child { grid-column: 1 / -1; }
  .zoom { all: unset; cursor: zoom-in; display: block; overflow: hidden; min-height: 110px; }
  .zoom:focus-visible { outline: 2px solid var(--acc); outline-offset: -2px; }
  .zoom :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
  .zoom:hover :global(img) { transform: scale(1.04); }
  figcaption { display: grid; grid-template-columns: 1fr auto; border-top: 1px solid var(--line); font: 500 .74rem var(--f-m); letter-spacing: .04em; background: var(--bg2); }
  figcaption span { padding: 7px 12px; }
  figcaption span + span { border-left: 1px solid var(--line); color: var(--acc); }
  dialog { border: 1px solid var(--line); background: var(--bg2); color: var(--ink); padding: 0; max-width: min(1200px, 94vw); }
  dialog::backdrop { background: rgba(6, 7, 11, .85); }
  dialog img { display: block; max-width: 100%; max-height: 82vh; }
  dialog form { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 12px; font: 500 .78rem var(--f-m); border-top: 1px solid var(--line); }
  dialog button { font: inherit; background: transparent; color: var(--acc); border: 1px solid var(--acc); padding: 4px 10px; cursor: pointer; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; }
    .right { display: grid; gap: 14px; }
    .sheets { position: static; grid-template-rows: none; }
    figure, figure:first-child { grid-column: auto; }
    .zoom { aspect-ratio: 16 / 10; }
    .hint { position: static; }
  }
  /* celular: todo en una columna. La línea de tiempo conserva el formato de
     escritorio (rev · fecha · texto) en columnas más angostas, y las láminas se
     apilan: en carrusel solo se veían dos etapas y una lámina, sin pista de que
     había más. */
  @media (max-width: 760px) {
    .quien { gap: 14px; align-items: start; }
    .quien :global(.foto) { width: 72px; height: 72px; }
    .origin { font-size: 1rem; }
    .time li { grid-template-columns: 14px 4rem 1fr; gap: 8px; padding: 8px 0; font-size: .9rem; }
    .date { font-size: .75rem; }
    .sheets { grid-template-columns: 1fr; }
    figcaption { font-size: .75rem; }
    figcaption span { padding: 8px 12px; }
  }
  /* teléfono en horizontal: las tres láminas en fila para no sumar 1300 px de alto */
  @media (min-width: 560px) and (max-width: 760px) {
    .sheets { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    figcaption span { padding: 8px; }
  }
  /* textos compactos y rótulo de láminas: solo existen en el modo celular */
  .m, .lam-t { display: none; }

  /* ── modo celular (html.movil): dos subpantallas que caben sin desplazar ──
     1) título, retrato con origen y las 8 etapas en 1–2 renglones cada una;
     2) las tres láminas (una grande, dos abajo) con su rótulo y la pista. */
  :global(html.movil) .d { display: none; }
  :global(html.movil) .m { display: inline; }
  :global(html.movil) .cols { grid-template-columns: minmax(0, 1fr); gap: 0; }
  :global(html.movil) .left { gap: 14px; align-content: start; }
  :global(html.movil) .quien { grid-template-columns: 56px minmax(0, 1fr); gap: 12px; align-items: start; }
  :global(html.movil) .quien :global(.foto) { width: 56px; height: 56px; }
  :global(html.movil) .origin { font-size: .9rem; line-height: 1.4; }
  :global(html.movil) .time li { grid-template-columns: 12px 3.9rem minmax(0, 1fr); gap: 8px; padding: 5px 0; font-size: .85rem; line-height: 1.35; }
  :global(html.movil) .date { font-size: .75rem; }
  :global(html.movil) .right { position: static; display: grid; gap: 10px; }
  :global(html.movil) .lam-t { display: block; }
  :global(html.movil) .sheets { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; gap: 10px; }
  :global(html.movil) figure:first-child { grid-column: 1 / -1; }
  :global(html.movil) .zoom { min-height: 0; aspect-ratio: 4 / 3; }
  :global(html.movil) figure:first-child .zoom { aspect-ratio: 16 / 10; }
  :global(html.movil) figcaption { font-size: .75rem; }
  :global(html.movil) figcaption span { padding: 7px 10px; }
  :global(html.movil) .hint { position: static; }
  /* teléfonos de 320 px: el retrato flota y el texto lo rodea; renglones más
     apretados para que las 8 etapas quepan o casi (lo que sobre se desplaza) */
  @media (max-width: 360px) {
    :global(html.movil) .left { gap: 10px; }
    :global(html.movil) .quien { display: block; }
    :global(html.movil) .quien :global(.foto) { float: left; width: 48px; height: 48px; margin: 3px 10px 0 0; }
    :global(html.movil) .origin { font-size: .85rem; line-height: 1.38; }
    :global(html.movil) .time li { grid-template-columns: 10px 3.6rem minmax(0, 1fr); gap: 6px; padding: 4px 0; font-size: .8rem; line-height: 1.32; }
  }
  /* teléfono en horizontal: las tres láminas en fila */
  @media (orientation: landscape) {
    :global(html.movil) .sheets { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    :global(html.movil) figure:first-child { grid-column: auto; }
    :global(html.movil) figure:first-child .zoom { aspect-ratio: 4 / 3; }
  }
  /* zoom en celular (vertical u horizontal): la lámina ocupa el ancho, cabe en
     alto y el botón de cerrar mide al menos 44 px */
  :global(html.movil) dialog { width: calc(100vw - 16px); max-width: calc(100vw - 16px); max-height: calc(100svh - 16px); overflow: auto; }
  :global(html.movil) dialog img { width: 100%; height: auto; max-height: 80svh; object-fit: contain; background: #1B2128; }
  :global(html.movil) dialog form { padding: 6px 6px 6px 12px; font-size: .78rem; }
  :global(html.movil) dialog button { min-height: 44px; min-width: 44px; padding: 0 14px; flex: none; }
  /* la pista de la tecla Esc solo donde hay teclado y cursor */
  @media (hover: none), (pointer: coarse) { .esc { display: none; } }
  /* celular en vertical: la lámina es muy ancha; ampliada al alto disponible se
     recorre de lado con el dedo. El pie con «Cerrar» se queda fijo a la izquierda. */
  @media (orientation: portrait) {
    :global(html.movil) dialog img { width: auto; max-width: none; height: min(62svh, 560px); max-height: none; }
    :global(html.movil) dialog form { position: sticky; left: 0; width: calc(100vw - 18px); }
  }
  h3.lam-t { margin: 0; font-weight: 500; letter-spacing: .1em; } /* se ve como etiqueta; es encabezado para el lector */
</style>

<script>
  const tr = document.querySelector<HTMLElement>(".trayectoria");
  if (tr) {
    const dlg = tr.querySelector<HTMLDialogElement>(".dlg")!;
    const dimg = dlg.querySelector("img")!;
    tr.querySelectorAll<HTMLButtonElement>(".zoom").forEach((b) => b.addEventListener("click", () => {
      const img = b.querySelector("img")!;
      dimg.src = img.dataset.full ?? img.currentSrc; dimg.alt = img.alt;
      dlg.querySelector(".cap")!.textContent = b.dataset.title ?? "";
      dlg.showModal();
    }));
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
