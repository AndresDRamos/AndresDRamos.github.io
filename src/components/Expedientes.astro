---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const x = content[lang].files;
---
<section class="block wrap" id="expedientes">
  <header class="sec-h"><span class="num">II</span><div><h2>{x.title}</h2><p>{x.introA}<span class="claim">{x.introClaim}</span>{x.introB}</p></div></header>
  <div class="files">
    {x.items.map((it) => (
      <article class="file">
        <span class="no">{it.id}</span>
        <div><h3>{it.title}</h3><span class="area">{it.area}</span></div>
        <div class="txt">
          <p><b>{x.labels.problem}</b>{it.problem}</p>
          <p><b>{x.labels.method}</b>{it.method}</p>
          <p class="ev"><b>{x.labels.evidence}</b>{it.evidence}</p>
        </div>
        <span class:list={["stamp", { warn: it.verdict === "warn" }]}>{it.stamp}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .files { border-top: 1px solid var(--ink); }
  .file { display: grid; grid-template-columns: 90px minmax(0, 1.1fr) minmax(0, 1.6fr) 150px; gap: 24px; padding: 26px 0; border-bottom: 1px solid var(--rule); align-items: start; position: relative; }
  .no { font: 500 .74rem var(--f-m); color: var(--muted); letter-spacing: .1em; padding-top: 8px; }
  h3 { font-size: 1.75rem; line-height: 1.05; }
  .area { font: 500 .7rem var(--f-m); letter-spacing: .12em; text-transform: uppercase; color: var(--seal); margin-top: 8px; display: block; }
  .txt { display: grid; gap: 8px; font-size: .96rem; }
  .txt b { font: 500 .68rem var(--f-m); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); display: block; margin-bottom: 2px; }
  .ev { display: none; background: var(--mark); padding: 10px 12px; border-radius: 4px; font-size: .92rem; }
  .stamp { justify-self: end; align-self: center; font: 600 .7rem/1.3 var(--f-m); letter-spacing: .14em; text-transform: uppercase; color: var(--ok);
    border: 2px solid currentColor; border-radius: 4px; padding: 8px 10px; transform: rotate(-8deg); opacity: .55; transition: opacity .25s, transform .25s; text-align: center; max-width: 150px; }
  .stamp.warn { color: var(--warn); }
  .file:hover .stamp { opacity: 1; transform: rotate(-4deg) scale(1.06); }
  :global(body.audit) .ev { display: block; }
  :global(body.audit) .stamp { opacity: 1; }
  :global(body.audit) .claim { background: linear-gradient(transparent 62%, var(--mark) 62%); }
  @media (max-width: 900px) {
    .file { grid-template-columns: 1fr; gap: 10px; }
    .stamp { position: absolute; top: 22px; right: 10px; max-width: 120px; }
    h3 { padding-right: 120px; }
  }
  @media print { .ev { display: block; } .stamp { opacity: 1; } .file { break-inside: avoid; } }
</style>
