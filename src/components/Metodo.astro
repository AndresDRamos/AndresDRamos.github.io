---
/*
  Método en tres etapas, un panel por etapa. Arriba, la espina de tres etapas
  es también el título: la etapa activa se lee grande (es el h2 del panel) y las
  otras dos son enlaces pequeños para saltar a ellas. A la izquierda los dos pasos de la
  etapa; a la derecha lo que se ofrece en ella:
    1 · Primeros pasos (estudiar y diseñar)        → las cinco capas de soluciones
    2 · Pruebas (probar y presupuestar)            → el método de laboratorio
    3 · Entrega (implementar y capacitar)          → lo que queda en la empresa y el ciclo de mejora
  Los términos del glosario se subrayan dentro de los párrafos.
  Entre etapas es la misma página: la espina, la luz y el bloque derecho se
  quedan quietos y solo entran los textos (data-grupo="metodo"; ver Header).
  Celular (html.movil): cada etapa cabe en una pantalla. Arriba, fija, la barra
  «Cómo trabajo · Etapa n de 3» y la espina como navegador (.ruta-m, tres pasos
  con nombre); textos compactos de i18n/movil/metodo.ts. Primeros pasos cabe en
  una pantalla: las capas son una fila de pestañas 1–5 con la elegida debajo; el
  laboratorio y el ciclo, filas cortas. El bloque de la derecha (.modulo) entra
  completo, con su recuadro, en vez de solo su texto.
*/
import { content, type Lang } from "../i18n/content";
import { marcar } from "../i18n/terminos";
import { metodoMovil } from "../i18n/movil/metodo";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const m = c.method, l = c.layers, lab = c.lab, op = c.operate, g = c.glossary;
const mk = (t: string) => marcar(t, g);
/* celular: textos compactos (i18n/movil). Se pintan los dos y el CSS muestra
   uno u otro según html.movil (.t-d escritorio, .t-m celular) */
const mv = metodoMovil[lang];
const dos = (d: string, m: string) => `<span class="t-d">${mk(d)}</span><span class="t-m">${mk(m)}</span>`;
const arriba = l.items.map((it, i) => ({ ...it, i })).reverse();
const nf = m.phases.length;
/* texto nuevo (no está en content.ts): «Etapa 1 de 3» */
const etapa = (k: number) => c.ui.stage.replace("{n}", String(k + 1)).replace("{t}", String(nf));
---
{m.phases.map((ph, f) => (
  <section class:list={["panel fase", `fase-${f}`]} id={ph.id} data-nav data-parent={f ? "metodo" : undefined}
    data-grupo="metodo" data-title={c.ui.panels[ph.id]} style="--lx:72%;--ly:45%">
    <div class="wrap">
      <header class="cab">
        {/* aria-label distinto por etapa: apiladas en celular son tres nav seguidos */}
        <nav class="espina" aria-label={`${m.title} · ${etapa(f)}`}>
          {m.phases.map((q, k) => (
            <>
              {k > 0 && <span class:list={["tramo", { hecho: k <= f }]} aria-hidden="true"></span>}
              {k === f ? (
                <div class:list={["grupo actual", { k0: k === 0, kn: k === nf - 1 }]} aria-current="step">
                  <span class="kicker n-etapa" aria-hidden="true">{m.title} · {etapa(f)}</span>
                  <h2 class="tit">{q.title}</h2>
                  <span class="nodo" aria-hidden="true"></span>
                </div>
              ) : (
                <a href={`#${q.id}`} class:list={["grupo", { hecho: k < f, k0: k === 0, kn: k === nf - 1 }]}>
                  <span class="tit">{q.title}</span>
                  <span class="nodo" aria-hidden="true"></span>
                </a>
              )}
            </>
          ))}
          {/* solo celular: los tres pasos con su nombre, cada uno un objetivo táctil */}
          <ol class="ruta-m">
            {m.phases.map((q, k) => (
              <li class:list={[{ hecho: k < f, actual: k === f, unido: k > 0 && k <= f }]}>
                {k === f ? (
                  <span class="pm" aria-current="step"><span class="nodo" aria-hidden="true"></span><span class="nm">{q.title}</span></span>
                ) : (
                  <a class="pm" href={`#${q.id}`}><span class="nodo" aria-hidden="true"></span><span class="nm">{q.title}</span></a>
                )}
              </li>
            ))}
          </ol>
        </nav>
        <p class="lema" data-r set:html={dos(ph.intro, mv.intro[f])} />
      </header>

      <div class="cuerpo">
        <div class="pasos">
          {ph.steps.map((si, k) => {
            const s = m.steps[si];
            return (
              <article class="paso" data-r style={`--i:${k + 1}`}>
                <h3>{s.title}</h3>
                <p set:html={dos(s.body, mv.steps[si].body)} />
                <p class="lleva"><span class="kicker">{m.get}<span class="sr-only">: </span></span><span set:html={dos(s.get, mv.steps[si].get)} /></p>
              </article>
            );
          })}
        </div>

        <div class="modulo">
          {f === 0 && (
            <div class="capas" data-r style="--i:2">
              <p class="kicker c-acc">{l.kicker}</p>
              <p class="intro">{l.intro}</p>
              <div class="cg">
                <div class="pila" role="tablist" aria-orientation="vertical" aria-label={l.kicker}>
                  <span class="columna" aria-hidden="true"><span class="impulso"></span></span>
                  {arriba.map((it) => (
                    <button type="button" role="tab" class="capa" id={`c-tab-${it.i}`} aria-controls={`c-det-${it.i}`}
                      aria-selected={it.i === 0 ? "true" : "false"} tabindex={it.i === 0 ? 0 : -1}>
                      <span class="n">{it.n}</span><span class="t">{it.title}</span>
                    </button>
                  ))}
                </div>
                <div class="dets">
                  {l.items.map((it, i) => (
                    <article class="det" role="tabpanel" id={`c-det-${i}`} aria-labelledby={`c-tab-${i}`} data-on={i === 0 ? "" : undefined}>
                      <h4>{it.title}</h4>
                      <p set:html={dos(it.body, mv.layers[i])} />
                      <ul>{it.list.map((x) => <li set:html={mk(x)} />)}</ul>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          )}

          {f === 1 && (
            <div class="lab" data-r style="--i:2">
              <p class="kicker c-acc">{lab.kicker}</p>
              <p class="intro" set:html={dos(lab.body, mv.lab.body)} />
              <div class="ruta">
                <span class="linea" aria-hidden="true"><span class="pulso"></span></span>
                <ol class="etapas">
                  {lab.flow.map((x, i) => (
                    <li class:list={["etapa", { origen: i === 0 }]} style={`--d:${i}`}>
                      <span class="n">{String(i + 1).padStart(2, "0")}</span><span class="t">{x}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <ul class="puntos">{lab.points.map((p, i) => <li set:html={dos(p, mv.lab.points[i])} />)}</ul>
            </div>
          )}

          {f === 2 && (
            <div class="opera" data-r style="--i:2">
              <p class="kicker c-acc">{op.kicker}</p>
              <ul class="queda">{op.list.map((x) => <li>{x}</li>)}</ul>
              <div class="ciclo">
                <div class="aro" aria-hidden="true">
                  <span class="pulso"></span>
                  {op.loop.map((x, i) => <span class={`p p${i}`}><i></i>{x}</span>)}
                </div>
                <p set:html={dos(op.loopText, mv.operate.loopText)} />
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
))}

<style>
  .cab { display: grid; gap: clamp(10px, 1.8vh, 18px); }

  /* espina-título: tres etapas, cada nombre centrado sobre su rombo.
     Columnas: etapa · tramo · etapa · tramo · etapa. La primera etapa empieza en
     el borde izquierdo y la última termina en el derecho, así el texto nunca se
     sale: lo que se recorta es la línea (el primer rombo queda a media palabra
     del borde). Cada etapa reserva el ancho de su nombre a tamaño grande (los
     inactivos solo se ven reducidos con scale) y la espina no brinca entre etapas.
     El script calcula --tit, el tamaño con el que los nombres llenan la fila
     dejando al menos 48 px de línea entre etapas. */
  .espina { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: end; }
  .grupo { position: relative; isolation: isolate; display: grid; justify-items: center; gap: 10px; text-decoration: none; color: var(--muted); }
  /* la línea: media línea a cada lado del rombo dentro de la etapa + el tramo
     entre etapas; se ve continua de rombo a rombo */
  .grupo::before, .grupo::after { content: ""; position: absolute; z-index: -1; bottom: 8px; width: 50%; height: 2px; background: var(--line); }
  .grupo::before { left: 0; }
  .grupo::after { right: 0; }
  .grupo.k0::before, .grupo.kn::after { display: none; }
  /* piezas solo de celular (ver «modo apilado» abajo) */
  .n-etapa, .ruta-m { display: none; }
  .tramo { min-width: 48px; height: 2px; margin-bottom: 8px; background: var(--line); }
  .grupo:is(.hecho, .actual)::before, .grupo.hecho::after, .tramo.hecho { background: color-mix(in srgb, var(--acc) 60%, var(--line)); }
  .nodo { width: 14px; height: 14px; margin: 2px; transform: rotate(45deg); border: 2px solid var(--line); background: var(--bg); transition: background .3s, border-color .3s; }
  .hecho .nodo { border-color: var(--acc); background: color-mix(in srgb, var(--acc) 35%, var(--bg)); }
  .actual .nodo { border-color: var(--acc); background: var(--acc); box-shadow: 0 0 0 5px color-mix(in srgb, var(--acc) 18%, transparent); }
  .tit { font: 600 var(--tit, clamp(1.5rem, 2.3vw, 2.4rem))/1.05 var(--f-b); letter-spacing: -.03em; white-space: nowrap; color: var(--ink); }
  /* el nombre chico se apoya abajo, centrado sobre su rombo: al volverse
     título crece hacia arriba desde el mismo punto */
  span.tit { color: var(--muted); transform: scale(.55); transform-origin: 50% 85%; transition: color .2s; }
  .grupo:hover span.tit { color: var(--acc); }
  .grupo:focus-visible { outline-offset: 6px; }
  /* el glitch de entrada (global.css) en el título de la etapa */
  :global(.js .panel.active.glitch-in) h2.tit { animation: glitch-in .34s steps(1) .22s; }
  .lema { color: var(--muted); max-width: 80ch; }
  /* las tres etapas miden lo mismo (el script iguala su alto): centradas en la
     pantalla, la espina y el bloque derecho quedan a la misma altura en las tres */
  .fase > .wrap { grid-template-rows: auto 1fr; }

  .cuerpo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(20px, 4vw, 64px); align-items: stretch; }
  .pasos { display: grid; gap: clamp(14px, 3vh, 32px); align-content: center; }
  .paso { display: grid; gap: clamp(6px, 1.2vh, 12px); }
  h3 { font-size: clamp(1.6rem, 1rem + 2vw, 2.8rem); line-height: 1; letter-spacing: -.035em; }
  .paso > p { color: var(--muted); font-size: clamp(.95rem, .9rem + .25vw, 1.1rem); line-height: 1.55; max-width: 56ch; }
  .lleva { display: grid; gap: 4px; padding-left: 14px; border-left: 2px solid var(--acc); font-size: .95rem; line-height: 1.45; }

  /* el corte a 45° va en el fondo (::before) y no en el bloque: así las
     definiciones del glosario que salen de él no quedan recortadas */
  .modulo { position: relative; isolation: isolate; padding: clamp(16px, 3vh, 32px) clamp(16px, 2.2vw, 36px); display: grid; align-content: center; }
  .modulo::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--bg2);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  .intro { margin-top: 6px; font-size: clamp(1rem, .95rem + .3vw, 1.2rem); line-height: 1.45; }

  /* 1 · capas */
  .cg { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(16px, 2vw, 32px); margin-top: clamp(12px, 2.4vh, 24px); align-items: center; }
  .pila { position: relative; display: grid; gap: clamp(5px, 1vh, 9px); padding-left: 28px; }
  .columna { position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; background: var(--line); overflow: hidden; }
  .impulso { position: absolute; left: 0; width: 2px; height: 30%; bottom: -30%; background: linear-gradient(to top, transparent, var(--acc)); animation: sube 2.6s cubic-bezier(.4, 0, .6, 1) infinite; }
  @keyframes sube { to { bottom: 100%; } }
  .capa { all: unset; box-sizing: border-box; cursor: pointer; position: relative; display: flex; align-items: baseline; gap: 12px;
    padding: clamp(9px, 1.6vh, 14px) 14px; background: var(--bg); color: var(--muted); border-left: 2px solid var(--line);
    transition: background .25s, color .25s, border-color .25s; }
  .capa::before { content: ""; position: absolute; left: -26px; top: 50%; width: 8px; height: 8px; margin-top: -4px; transform: rotate(45deg); background: var(--bg2); border: 2px solid var(--line); }
  .capa:hover { color: var(--ink); border-left-color: color-mix(in srgb, var(--acc) 50%, var(--line)); }
  .capa:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }
  .capa[aria-selected="true"] { color: var(--ink); border-left-color: var(--acc); background: color-mix(in srgb, var(--acc) 12%, var(--bg)); }
  .capa[aria-selected="true"]::before { background: var(--acc); border-color: var(--acc); }
  .capa .n { font: 500 .74rem/1 var(--f-m); color: var(--acc); }
  .capa .t { font: 600 clamp(.9rem, .8rem + .35vw, 1.1rem)/1.15 var(--f-b); }
  .dets { display: grid; }
  .det { display: grid; gap: 8px; align-content: start; }
  .det + .det { margin-top: 20px; }
  h4 { margin: 0; font-size: clamp(1.2rem, .9rem + 1vw, 1.7rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 600; }
  .det p { color: var(--muted); font-size: .95rem; line-height: 1.5; }
  .det li { position: relative; padding: 7px 0 7px 22px; border-top: 1px solid var(--line); font-size: .92rem; line-height: 1.4; }
  .det li::before, .queda li::before, .puntos li::before { content: "◆"; position: absolute; left: 2px; color: var(--acc); font-size: .65em; top: calc(7px + .45em); }
  :global(.js) .det { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transform: translateX(14px); transition: opacity .35s, transform .45s cubic-bezier(.2, .7, .2, 1), visibility .35s; }
  :global(.js) .det[data-on] { opacity: 1; visibility: visible; transform: none; }

  /* 2 · laboratorio */
  .ruta { position: relative; margin-top: clamp(14px, 3vh, 28px); }
  .etapas { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .linea { position: absolute; left: 4%; right: 4%; top: 50%; height: 2px; background: repeating-linear-gradient(90deg, var(--line) 0 8px, transparent 8px 14px); }
  .ruta .pulso { position: absolute; top: -3px; left: 0; width: 8px; height: 8px; background: var(--acc); animation: recorre 4.5s linear infinite; }
  @keyframes recorre { from { left: 0; } to { left: 100%; } }
  .etapa { position: relative; z-index: 1; display: grid; gap: 6px; align-content: center; min-height: clamp(74px, 13vh, 120px); padding: 12px; background: var(--bg);
    border-left: 2px solid var(--line); animation: late 4.5s linear infinite; animation-delay: calc(var(--d) * .9s); }
  @keyframes late { 0%, 12%, 100% { border-left-color: var(--line); } 4% { border-left-color: var(--acc); } }
  .etapa.origen { background: color-mix(in srgb, var(--acc) 16%, var(--bg)); border-left-color: var(--acc); animation: none; }
  .etapa .n { font: 500 .68rem/1 var(--f-m); color: var(--acc); letter-spacing: .08em; }
  .etapa .t { font: 600 clamp(.85rem, .75rem + .35vw, 1.05rem)/1.15 var(--f-b); }
  .puntos { margin-top: clamp(12px, 2.6vh, 24px); display: grid; }
  .puntos li, .queda li { position: relative; padding: 8px 0 8px 22px; border-top: 1px solid var(--line); line-height: 1.4; }
  .puntos li::before, .queda li::before { top: calc(8px + .45em); }

  /* 3 · operación y ciclo */
  .queda { margin-top: 12px; display: grid; }
  .ciclo { display: grid; grid-template-columns: auto 1fr; gap: clamp(28px, 3vw, 48px); align-items: center; margin-top: clamp(20px, 4vh, 40px); padding: 14px; }
  .ciclo p { color: var(--muted); line-height: 1.5; }
  .aro { position: relative; width: clamp(110px, 11vw, 150px); aspect-ratio: 1; border: 2px dashed var(--line); transform: rotate(45deg); margin: 18px; }
  .aro .p { position: absolute; display: grid; justify-items: center; gap: 4px; transform: translate(-50%, -50%) rotate(-45deg); font: 500 .7rem/1 var(--f-m); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .aro .p i { width: 12px; height: 12px; transform: rotate(45deg); background: var(--bg2); border: 2px solid var(--acc); }
  .p0 { left: 0; top: 0; } .p1 { left: 100%; top: 0; } .p2 { left: 100%; top: 100%; } .p3 { left: 0; top: 100%; }
  .p3 i { background: var(--acc); }
  .aro .pulso { position: absolute; width: 8px; height: 8px; margin: -5px; background: var(--sin); animation: vuelta 5s linear infinite; }
  @keyframes vuelta { 0% { left: 0; top: 0; } 25% { left: 100%; top: 0; } 50% { left: 100%; top: 100%; } 75% { left: 0; top: 100%; } 100% { left: 0; top: 0; } }

  /* los impulsos solo corren en el panel que se ve */
  :global(.js) .fase:not(.active) :is(.impulso, .pulso, .etapa) { animation-play-state: paused; }

  /* laptops de poca altura (1366×768, 1440×900): todo el panel cabe sin desplazar */
  @media (min-width: 901px) and (max-height: 820px) {
    :global(.js) .fase { padding-block: clamp(14px, 2.6vh, 32px); }
    .fase > .wrap { gap: clamp(14px, 2.6vh, 32px); }
    .pasos { gap: clamp(12px, 2.4vh, 24px); }
    .paso { gap: 6px; }
    h3 { font-size: clamp(1.4rem, .8rem + 1.6vw, 2.3rem); }
    .paso > p { font-size: .95rem; line-height: 1.5; max-width: 60ch; }
    .lleva { font-size: .9rem; line-height: 1.4; }
  }

  /* pantallas medianas: no caben los tres títulos; los inactivos quedan solo
     como nodos (su nombre sigue disponible para lectores de pantalla) */
  @media (max-width: 1100px) {
    .espina { display: flex; align-items: flex-end; }
    .tramo { flex: 1 1 24px; min-width: 24px; }
    .actual { flex: 0 1 auto; min-width: 0; }
    h2.tit { white-space: normal; text-align: center; font-size: clamp(1.6rem, 4.2vw, 2.4rem); }
    span.tit { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; gap: 16px; }
    .cg { grid-template-columns: 1fr; }
    .ciclo { grid-template-columns: 1fr; justify-items: center; }
    .aro .p { font-size: .75rem; }

    /* laboratorio: recorrido vertical 01→05, una línea punteada une los rombos
       y el pulso baja por ella; sin cajas, para que no parezcan botones.
       La primera línea de cada paso mide 24 px y empieza a 10 px: su centro
       (22 px) es el del rombo y el extremo de la línea. */
    .etapas { grid-template-columns: 1fr; gap: 0; }
    .linea { left: 4px; right: auto; top: 22px; bottom: 22px; width: 2px; height: auto;
      background: repeating-linear-gradient(180deg, var(--line) 0 8px, transparent 8px 14px); }
    .ruta .pulso { top: 0; left: -3px; margin-top: -4px; animation-name: baja; }
    .etapa { min-height: 0; grid-template-columns: auto 1fr; align-items: baseline; gap: 12px; padding: 10px 0 10px 30px;
      background: none; border-left: 0; animation: none; }
    .etapa::before { content: ""; position: absolute; left: 0; top: 17px; width: 10px; height: 10px; transform: rotate(45deg);
      background: var(--bg2); border: 2px solid var(--acc); animation: late-m 4.5s linear infinite; animation-delay: calc(var(--d) * 1.125s); }
    .etapa.origen { background: none; }
    .etapa.origen::before { background: var(--acc); animation: none; }
    .etapa .n { font-size: .75rem; }
    .etapa .t { font-size: 1rem; line-height: 24px; }
  }
  @keyframes baja { from { top: 0; } to { top: 100%; } }
  @keyframes late-m { 0%, 9%, 100% { background: var(--bg2); box-shadow: none; } 3% { background: var(--acc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--acc) 22%, transparent); } }
  :global(.js) .fase:not(.active) .etapa::before { animation-play-state: paused; }

  /* ciclo en una fila corta (celular vertical y teléfono acostado):
     ◆ Operar → ◆ Medir → ◆ Mejorar → ◆ Estudiar ↺ */
  @media (max-width: 760px), (max-height: 500px) {
    .ciclo { grid-template-columns: 1fr; justify-items: start; gap: 10px; margin-top: 20px; padding: 16px 0 0; border-top: 1px solid var(--line); }
    .aro { width: auto; aspect-ratio: auto; margin: 0; border: 0; transform: none; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 8px; }
    .aro .pulso { display: none; }
    .aro .p { position: static; transform: none; display: inline-flex; align-items: center; gap: 8px; font-size: .75rem; letter-spacing: .06em; }
    .aro .p i { width: 9px; height: 9px; }
    .aro .p + .p::before { content: "→"; color: var(--muted); letter-spacing: 0; }
    .aro .p3::after { content: "↺"; color: var(--acc); font-size: 1rem; letter-spacing: 0; }
  }

  /* ── celular (html.movil) ──
     Cada etapa cabe en una pantalla. Arriba, igual y en el mismo lugar en las
     tres etapas, la barra del método: «Cómo trabajo · Etapa n de 3» y la espina
     como navegador (tres pasos con nombre, cada uno un objetivo táctil; la etapa
     actual resaltada). Tocar otra etapa cambia el contenido sin mover la página
     (main.mismo, Header). El contenido empieza arriba y no centrado: así la barra
     no brinca aunque las etapas midan distinto. El h2 (nombre de la etapa) queda
     solo para lector de pantalla: a la vista ya está resaltado en la espina.
     Textos compactos (.t-m, i18n/movil/metodo.ts) en lugar de los de escritorio (.t-d). */
  .fase :global(.t-m) { display: none; }
  :global(html.movil) .fase :global(.t-d) { display: none; }
  :global(html.movil) .fase :global(.t-m) { display: inline; }
  :global(html.movil) .fase.panel { padding: 12px 0 10px; }
  :global(html.movil) .fase > .wrap { margin-block: 0 auto; gap: 10px; }
  :global(html.movil) .cab { gap: 8px; }
  :global(html.movil) .espina { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; align-items: start; padding-bottom: 2px; border-bottom: 1px solid var(--line); }
  :global(html.movil) .espina > :is(a.grupo, .tramo) { display: none; }
  :global(html.movil) .espina > .actual { display: block; order: -2; }
  :global(html.movil) .espina > .actual::before,
  :global(html.movil) .espina > .actual::after,
  :global(html.movil) .espina > .actual > .nodo { display: none; }
  :global(html.movil) .n-etapa { display: block; color: var(--acc); }
  :global(html.movil) h2.tit { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(html.movil) .ruta-m { order: -1; position: relative; isolation: isolate; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ruta-m li { position: relative; display: grid; }
  /* tramo de línea: del rombo anterior a este (detrás de los rombos) */
  .ruta-m li + li::before { content: ""; position: absolute; z-index: -1; top: 13px; left: -50%; width: 100%; height: 2px; background: var(--line); }
  .ruta-m li.unido::before { background: color-mix(in srgb, var(--acc) 60%, var(--line)); }
  .pm { display: grid; justify-items: center; align-content: start; gap: 4px; min-height: 44px; padding: 5px 4px 4px; text-decoration: none; color: var(--muted); }
  .pm .nodo { margin: 2px; }
  .nm { font: 500 .8125rem/1.25 var(--f-b); text-align: center; text-wrap: balance; }
  .actual .nm { color: var(--ink); font-weight: 600; }
  a.pm:hover { color: var(--acc); }
  a.pm:hover .nodo { border-color: var(--acc); }
  a.pm:focus-visible { outline-offset: 0; }
  :global(html.movil) .lema { font-size: 1rem; line-height: 1.45; }

  /* pasos: título, texto corto y «Te llevas» en una línea (etiqueta + texto) */
  :global(html.movil) .cuerpo { gap: 12px; align-items: start; }
  :global(html.movil) .pasos { gap: 12px; align-content: start; }
  :global(html.movil) .paso { gap: 4px; }
  :global(html.movil) h3 { font-size: 1.25rem; line-height: 1.15; letter-spacing: -.025em; }
  :global(html.movil) .paso > p { font-size: .9375rem; line-height: 1.45; }
  :global(html.movil) .lleva { display: block; padding-left: 10px; font-size: .8125rem; line-height: 1.4; }
  :global(html.movil) .lleva .kicker { margin-right: 6px; letter-spacing: .04em; color: var(--acc); }
  :global(html.movil) .modulo { padding: 10px 12px 12px; align-content: start; }
  :global(html.movil) .intro { margin-top: 4px; font-size: .875rem; line-height: 1.4; }

  /* laboratorio: el recorrido en dos filas (◆ Laboratorio ◇ Lo ves funcionar
     ◇ …); los rombos se encienden en orden, eso marca el sentido */
  :global(html.movil) .ruta { margin-top: 10px; }
  :global(html.movil) .ruta .linea { display: none; }
  :global(html.movil) .etapas { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
  :global(html.movil) .etapa { display: inline-flex; align-items: center; gap: 7px; min-height: 0; padding: 0; background: none; border-left: 0; animation: none;
    font: 500 .8125rem/1.3 var(--f-b); }
  :global(html.movil) .etapa::before { content: ""; position: static; flex: none; width: 9px; height: 9px; transform: rotate(45deg);
    background: var(--bg2); border: 2px solid var(--acc); animation: late-m 4.5s linear infinite; animation-delay: calc(var(--d) * .9s); }
  :global(html.movil) .etapa.origen::before { background: var(--acc); animation: none; }
  :global(html.movil) .etapa .n { display: none; }
  :global(html.movil) .etapa .t { font: inherit; }
  :global(html.movil) .puntos { margin-top: 10px; }
  :global(html.movil) :is(.puntos, .queda) li { padding: 4px 0 4px 18px; font-size: .8125rem; line-height: 1.35; }
  :global(html.movil) :is(.puntos, .queda) li::before { left: 1px; top: calc(4px + .45em); }

  /* entrega */
  :global(html.movil) .queda { margin-top: 6px; }
  :global(html.movil) .ciclo { margin-top: 10px; padding-top: 10px; gap: 6px; }
  :global(html.movil) .aro { gap: 6px; }
  :global(html.movil) .aro .p { gap: 6px; letter-spacing: .03em; }
  /* la flecha va al final de cada paso: si la fila se parte, nunca abre la línea */
  :global(html.movil) .aro .p + .p::before { content: none; }
  :global(html.movil) .aro .p:not(.p3)::after { content: "→"; color: var(--muted); letter-spacing: 0; }
  :global(html.movil) .ciclo p { font-size: .875rem; line-height: 1.4; }

  /* teléfonos de 320 px: un paso menos de letra para acercarse a una pantalla
     (si aun así no cabe, el panel se desplaza un poco) */
  @media (max-width: 359px) {
    :global(html.movil) .nm { font-size: .75rem; }
    :global(html.movil) .pm { padding-inline: 2px; }
    :global(html.movil) .lema { font-size: .9375rem; line-height: 1.4; }
    :global(html.movil) h3 { font-size: 1.125rem; }
    :global(html.movil) .paso > p { font-size: .875rem; line-height: 1.4; }
    :global(html.movil) .lleva { font-size: .75rem; }
  }

  /* primeros pasos en una pantalla: capas como fila de pestañas 1–5 (el script
     quita el acordeón en celular) y debajo la capa elegida: nombre y una línea */
  :global(html.movil) .capas > .intro { display: none; }
  :global(html.movil) .cg { margin-top: 8px; gap: 8px; }
  :global(html.movil) .pila { display: flex; flex-direction: row-reverse; gap: 4px; padding-left: 0; }
  :global(html.movil) .pila .columna, :global(html.movil) .capa::before { display: none; }
  :global(html.movil) .pila .capa { flex: 1 1 0; min-width: 0; min-height: 44px; justify-content: center; align-items: center; padding: 0;
    border-left: 0; border-bottom: 2px solid var(--line); }
  :global(html.movil) .pila .capa[aria-selected="true"] { border-bottom-color: var(--acc); }
  :global(html.movil) .pila .capa .n { font: 600 1.1rem/1 var(--f-b); }
  :global(html.movil) .pila .capa .t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(html.movil) .det { gap: 2px; }
  :global(html.movil) .det h4 { font-size: 1.05rem; line-height: 1.25; letter-spacing: -.015em; }
  :global(html.movil) .det ul { display: none; }

  /* el bloque de la derecha entra completo (recuadro y texto juntos) al cambiar
     de etapa: el revelado [data-r] pasa del contenido al .modulo */
  :global(html.js.movil) .fase .modulo { opacity: 0; transform: translateY(24px);
    transition: opacity .6s cubic-bezier(.2, .7, .2, 1), transform .6s cubic-bezier(.2, .7, .2, 1); }
  :global(html.paneles.movil) .fase.active .modulo { opacity: 1; transform: none; transition-delay: 340ms; }
  :global(html.movil) .fase .modulo > [data-r] { opacity: 1; transform: none; transition: none; }

  /* capas en acordeón (celular y pantallas ≤900 px; el script pone .acordeon):
     orden 1→5 y cada capa abre su detalle justo debajo */
  .acordeon .dets { display: none; }
  .acordeon .pila { gap: 6px; }
  .acordeon .impulso { background: linear-gradient(to bottom, transparent, var(--acc)); animation-direction: reverse; }
  .acordeon .capa { min-height: 48px; align-items: center; padding: 12px 14px; }
  .acordeon .capa .n { font-size: .75rem; }
  .acordeon .capa .t { flex: 1; font-size: 1rem; }
  .acordeon .capa::after { content: ""; flex: none; width: 8px; height: 8px; margin: -4px 4px 0 8px; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg); transition: transform .25s; }
  .acordeon .capa[aria-expanded="true"] { color: var(--ink); border-left-color: var(--acc); background: color-mix(in srgb, var(--acc) 12%, var(--bg)); }
  .acordeon .capa[aria-expanded="true"]::before { background: var(--acc); border-color: var(--acc); }
  .acordeon .capa[aria-expanded="true"]::after { margin-top: 4px; transform: rotate(-135deg); }
  :global(.js) .acordeon .det { grid-area: auto; margin-top: -6px; padding: 12px 14px 14px; background: var(--bg); border-left: 2px solid var(--acc);
    opacity: 1; visibility: visible; transform: none; transition: none; }
  :global(.js) .acordeon .det:not([data-on]) { display: none; }
  :global(.js) .acordeon .det[data-on] { animation: abre .3s cubic-bezier(.2, .7, .2, 1); }
  .acordeon .det h4 { display: none; }
  @keyframes abre { from { opacity: 0; transform: translateY(-6px); } }
  :global(html.movil) .det p { font-size: .8125rem; line-height: 1.4; }
  :global(html.movil) .det li { padding: 4px 0 4px 18px; font-size: .8125rem; line-height: 1.35; }
  :global(html.movil) .det li::before { left: 1px; top: calc(4px + .45em); }
  @media print {
    .modulo { display: none; }
  }
</style>

<script>
  /* mismo alto para las tres etapas: el panel centra su contenido, así que si
     una etapa es más alta que otra, todo (espina incluida) brincaría al cambiar.
     Solo en pantallas anchas; en celular el contenido ya empieza arriba. */
  const wraps = [...document.querySelectorAll<HTMLElement>(".fase > .wrap")];
  const ancho = matchMedia("(min-width: 901px)");
  const igualar = () => {
    wraps.forEach((w) => (w.style.minHeight = ""));
    if (!ancho.matches) return;
    const h = Math.max(...wraps.map((w) => w.offsetHeight));
    wraps.forEach((w) => (w.style.minHeight = `${h}px`));
  };
  /* títulos de la espina a todo el ancho: mide los tres a su tamaño actual y
     escala la letra para que llenen la fila (tope 3rem, para no quitar alto en laptops). Las tres espinas son
     iguales, así que se mide la primera y se aplica a todas. */
  const espinas = [...document.querySelectorAll<HTMLElement>(".fase .espina")];
  const fila = matchMedia("(min-width: 1101px)");
  const llenar = () => {
    espinas.forEach((e) => e.style.removeProperty("--tit"));
    const e = espinas[0];
    if (!e || !fila.matches) return;
    const tits = [...e.querySelectorAll<HTMLElement>(".tit")];
    const t0 = parseFloat(getComputedStyle(tits[0]).fontSize);
    const textos = tits.reduce((s, t) => s + t.offsetWidth, 0);
    const margen = [...e.querySelectorAll<HTMLElement>(".tramo")].reduce((s, g) => s + parseFloat(getComputedStyle(g).minWidth), 0);
    const tope = 3 * parseFloat(getComputedStyle(document.documentElement).fontSize);
    const t = Math.min(tope, (t0 * (e.clientWidth - margen - 4)) / textos);
    espinas.forEach((x) => x.style.setProperty("--tit", `${t.toFixed(2)}px`));
  };
  const medir = () => { llenar(); igualar(); };
  medir();
  addEventListener("resize", medir);
  document.fonts?.ready.then(medir);

  /* capas: dos patrones con los mismos nodos.
     · Pestañas (pantalla grande con .paneles y >900 px): lista 5→1 a la izquierda,
       detalle a la derecha; flechas arriba/abajo cambian de capa. Es el HTML de origen.
     · En celular (.movil) las mismas pestañas, en fila 1→5 (CSS).
     · Acordeón (901 px o menos sin .movil): botones 1→5 con aria-expanded y cada
       detalle movido justo debajo de su botón; se pueden abrir varias a la vez
       (cerrar las demás movería la capa tocada fuera de la pantalla). */
  const sec = document.querySelector<HTMLElement>(".fase-0 .capas");
  if (sec) {
    const root = document.documentElement;
    const pila = sec.querySelector<HTMLElement>(".pila")!;
    const caja = sec.querySelector<HTMLElement>(".dets")!;
    const etiqueta = pila.getAttribute("aria-label") ?? "";
    const idx = (t: HTMLElement) => Number(t.id.split("-").pop());
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>(".capa")].sort((a, b) => idx(a) - idx(b));
    const dets = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!);
    const estrecho = matchMedia("(max-width: 900px)");
    let acordeon = false;
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => { const on = k === i; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      dets.forEach((d, k) => d.toggleAttribute("data-on", k === i));
    };
    const abrir = (i: number, on: boolean) => {
      tabs[i].setAttribute("aria-expanded", String(on));
      dets[i].toggleAttribute("data-on", on);
    };
    const modo = () => {
      const fila = root.classList.contains("movil");
      pila.setAttribute("aria-orientation", fila ? "horizontal" : "vertical");
      const a = !fila && estrecho.matches;
      if (a === acordeon) return;
      acordeon = a;
      const abierta = Math.max(0, dets.findIndex((d) => d.hasAttribute("data-on")));
      sec.classList.toggle("acordeon", a);
      if (a) {
        ["role", "aria-orientation", "aria-label"].forEach((x) => pila.removeAttribute(x));
        tabs.forEach((t, i) => {
          t.removeAttribute("role"); t.removeAttribute("aria-selected"); t.removeAttribute("tabindex");
          dets[i].removeAttribute("role");
          pila.append(t, dets[i]);
          abrir(i, i === abierta);
        });
      } else {
        pila.setAttribute("role", "tablist"); pila.setAttribute("aria-orientation", root.classList.contains("movil") ? "horizontal" : "vertical"); pila.setAttribute("aria-label", etiqueta);
        [...tabs].reverse().forEach((t) => { t.setAttribute("role", "tab"); t.removeAttribute("aria-expanded"); pila.append(t); });
        dets.forEach((d) => { d.setAttribute("role", "tabpanel"); caja.append(d); });
        pick(abierta);
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        if (!acordeon) return pick(i);
        const on = t.getAttribute("aria-expanded") !== "true";
        abrir(i, on);
      });
      t.addEventListener("keydown", (e) => {
        if (acordeon) return;
        /* vertical (5 arriba): ↑ sube de capa; horizontal (celular, 1 a la izquierda): → avanza */
        const d = e.key === "ArrowUp" || e.key === "ArrowRight" ? 1 : e.key === "ArrowDown" || e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        pick((i + d + tabs.length) % tabs.length, true);
      });
    });
    modo();
    estrecho.addEventListener("change", modo);
    /* Base/Header ponen o quitan .movil al cambiar el tamaño de la ventana */
    new MutationObserver(modo).observe(root, { attributes: true, attributeFilter: ["class"] });
  }
</script>
