---
/*
  Método en tres etapas, un panel por etapa. Arriba, la espina de tres etapas
  es también el título: la etapa activa se lee grande (es el h2 del panel) y las
  otras dos son enlaces pequeños para saltar a ellas. A la izquierda los dos pasos de la
  etapa; a la derecha lo que se ofrece en ella:
    1 · Primeros pasos (estudiar y diseñar)        → las cinco capas de soluciones
    2 · Pruebas (probar y presupuestar)            → el método de laboratorio
    3 · Entrega (implementar y capacitar)          → lo que queda en la empresa y el ciclo de mejora
  Los términos del glosario se subrayan dentro de los párrafos.
  Entre etapas es la misma página: la espina, la luz y el bloque derecho se
  quedan quietos y solo entran los textos (data-grupo="metodo"; ver Header).
*/
import { content, type Lang } from "../i18n/content";
import { marcar } from "../i18n/terminos";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const m = c.method, l = c.layers, lab = c.lab, op = c.operate, g = c.glossary;
const mk = (t: string) => marcar(t, g);
const arriba = l.items.map((it, i) => ({ ...it, i })).reverse();
---
{m.phases.map((ph, f) => (
  <section class:list={["panel fase", `fase-${f}`]} id={ph.id} data-nav data-parent={f ? "metodo" : undefined}
    data-grupo="metodo" data-title={c.ui.panels[ph.id]} style="--lx:72%;--ly:45%">
    <div class="wrap">
      <header class="cab">
        <nav class="espina" aria-label={m.title}>
          {m.phases.map((q, k) => (
            <>
              {k > 0 && <span class:list={["tramo", { hecho: k <= f }]} aria-hidden="true"></span>}
              {k === f ? (
                <div class="grupo actual" aria-current="step">
                  <h2 class="tit">{q.title}</h2>
                  <span class="nodo" aria-hidden="true"></span>
                </div>
              ) : (
                <a href={`#${q.id}`} class:list={["grupo", { hecho: k < f }]}>
                  <span class="tit">{q.title}</span>
                  <span class="nodo" aria-hidden="true"></span>
                </a>
              )}
            </>
          ))}
        </nav>
        <p class="lema" data-r>{ph.intro}</p>
      </header>

      <div class="cuerpo">
        <div class="pasos">
          {ph.steps.map((si, k) => {
            const s = m.steps[si];
            return (
              <article class="paso" data-r style={`--i:${k + 1}`}>
                <h3>{s.title}</h3>
                <p set:html={mk(s.body)} />
                <p class="lleva"><span class="kicker">{m.get}</span><span set:html={mk(s.get)} /></p>
              </article>
            );
          })}
        </div>

        <div class="modulo">
          {f === 0 && (
            <div class="capas" data-r style="--i:2">
              <p class="kicker c-acc">{l.kicker}</p>
              <p class="intro">{l.intro}</p>
              <div class="cg">
                <div class="pila" role="tablist" aria-orientation="vertical" aria-label={l.kicker}>
                  <span class="columna" aria-hidden="true"><span class="impulso"></span></span>
                  {arriba.map((it) => (
                    <button type="button" role="tab" class="capa" id={`c-tab-${it.i}`} aria-controls={`c-det-${it.i}`}
                      aria-selected={it.i === 0 ? "true" : "false"} tabindex={it.i === 0 ? 0 : -1}>
                      <span class="n">{it.n}</span><span class="t">{it.title}</span>
                    </button>
                  ))}
                </div>
                <div class="dets">
                  {l.items.map((it, i) => (
                    <article class="det" role="tabpanel" id={`c-det-${i}`} aria-labelledby={`c-tab-${i}`} data-on={i === 0 ? "" : undefined}>
                      <h4>{it.title}</h4>
                      <p set:html={mk(it.body)} />
                      <ul>{it.list.map((x) => <li set:html={mk(x)} />)}</ul>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          )}

          {f === 1 && (
            <div class="lab" data-r style="--i:2">
              <p class="kicker c-acc">{lab.kicker}</p>
              <p class="intro" set:html={mk(lab.body)} />
              <div class="ruta">
                <span class="linea" aria-hidden="true"><span class="pulso"></span></span>
                <ol class="etapas">
                  {lab.flow.map((x, i) => (
                    <li class:list={["etapa", { origen: i === 0 }]} style={`--d:${i}`}>
                      <span class="n">{String(i + 1).padStart(2, "0")}</span><span class="t">{x}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <ul class="puntos">{lab.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          )}

          {f === 2 && (
            <div class="opera" data-r style="--i:2">
              <p class="kicker c-acc">{op.kicker}</p>
              <ul class="queda">{op.list.map((x) => <li>{x}</li>)}</ul>
              <div class="ciclo">
                <div class="aro" aria-hidden="true">
                  <span class="pulso"></span>
                  {op.loop.map((x, i) => <span class={`p p${i}`}><i></i>{x}</span>)}
                </div>
                <p>{op.loopText}</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
))}

<style>
  .cab { display: grid; gap: clamp(10px, 1.8vh, 18px); }

  /* espina-título: tres etapas, cada nombre centrado sobre su rombo.
     Columnas: etapa · tramo · etapa · tramo · etapa. La primera etapa empieza en
     el borde izquierdo y la última termina en el derecho, así el texto nunca se
     sale: lo que se recorta es la línea (el primer rombo queda a media palabra
     del borde). Cada etapa reserva el ancho de su nombre a tamaño grande (los
     inactivos solo se ven reducidos con scale) y la espina no brinca entre etapas.
     El script calcula --tit, el tamaño con el que los nombres llenan la fila
     dejando al menos 48 px de línea entre etapas. */
  .espina { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: end; }
  .grupo { position: relative; isolation: isolate; display: grid; justify-items: center; gap: 10px; text-decoration: none; color: var(--muted); }
  /* la línea: media línea a cada lado del rombo dentro de la etapa + el tramo
     entre etapas; se ve continua de rombo a rombo */
  .grupo::before, .grupo::after { content: ""; position: absolute; z-index: -1; bottom: 8px; width: 50%; height: 2px; background: var(--line); }
  .grupo::before { left: 0; }
  .grupo::after { right: 0; }
  .grupo:first-child::before, .grupo:last-child::after { display: none; }
  .tramo { min-width: 48px; height: 2px; margin-bottom: 8px; background: var(--line); }
  .grupo:is(.hecho, .actual)::before, .grupo.hecho::after, .tramo.hecho { background: color-mix(in srgb, var(--acc) 60%, var(--line)); }
  .nodo { width: 14px; height: 14px; margin: 2px; transform: rotate(45deg); border: 2px solid var(--line); background: var(--bg); transition: background .3s, border-color .3s; }
  .hecho .nodo { border-color: var(--acc); background: color-mix(in srgb, var(--acc) 35%, var(--bg)); }
  .actual .nodo { border-color: var(--acc); background: var(--acc); box-shadow: 0 0 0 5px color-mix(in srgb, var(--acc) 18%, transparent); }
  .tit { font: 600 var(--tit, clamp(1.5rem, 2.3vw, 2.4rem))/1.05 var(--f-b); letter-spacing: -.03em; white-space: nowrap; color: var(--ink); }
  /* el nombre chico se apoya abajo, centrado sobre su rombo: al volverse
     título crece hacia arriba desde el mismo punto */
  span.tit { color: var(--muted); transform: scale(.55); transform-origin: 50% 85%; transition: color .2s; }
  .grupo:hover span.tit { color: var(--acc); }
  .grupo:focus-visible { outline-offset: 6px; }
  /* el glitch de entrada (global.css) en el título de la etapa */
  :global(.js .panel.active.glitch-in) h2.tit { animation: glitch-in .34s steps(1) .22s; }
  .lema { color: var(--muted); max-width: 80ch; }
  /* las tres etapas miden lo mismo (el script iguala su alto): centradas en la
     pantalla, la espina y el bloque derecho quedan a la misma altura en las tres */
  .fase > .wrap { grid-template-rows: auto 1fr; }

  .cuerpo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(20px, 4vw, 64px); align-items: stretch; }
  .pasos { display: grid; gap: clamp(14px, 3vh, 32px); align-content: center; }
  .paso { display: grid; gap: clamp(6px, 1.2vh, 12px); }
  h3 { font-size: clamp(1.6rem, 1rem + 2vw, 2.8rem); line-height: 1; letter-spacing: -.035em; }
  .paso > p { color: var(--muted); font-size: clamp(.95rem, .9rem + .25vw, 1.1rem); line-height: 1.55; max-width: 56ch; }
  .lleva { display: grid; gap: 4px; padding-left: 14px; border-left: 2px solid var(--acc); font-size: .95rem; line-height: 1.45; }

  /* el corte a 45° va en el fondo (::before) y no en el bloque: así las
     definiciones del glosario que salen de él no quedan recortadas */
  .modulo { position: relative; isolation: isolate; padding: clamp(16px, 3vh, 32px) clamp(16px, 2.2vw, 36px); display: grid; align-content: center; }
  .modulo::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--bg2);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  .intro { margin-top: 6px; font-size: clamp(1rem, .95rem + .3vw, 1.2rem); line-height: 1.45; }

  /* 1 · capas */
  .cg { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(16px, 2vw, 32px); margin-top: clamp(12px, 2.4vh, 24px); align-items: center; }
  .pila { position: relative; display: grid; gap: clamp(5px, 1vh, 9px); padding-left: 28px; }
  .columna { position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; background: var(--line); overflow: hidden; }
  .impulso { position: absolute; left: 0; width: 2px; height: 30%; bottom: -30%; background: linear-gradient(to top, transparent, var(--acc)); animation: sube 2.6s cubic-bezier(.4, 0, .6, 1) infinite; }
  @keyframes sube { to { bottom: 100%; } }
  .capa { all: unset; box-sizing: border-box; cursor: pointer; position: relative; display: flex; align-items: baseline; gap: 12px;
    padding: clamp(9px, 1.6vh, 14px) 14px; background: var(--bg); color: var(--muted); border-left: 2px solid var(--line);
    transition: background .25s, color .25s, border-color .25s; }
  .capa::before { content: ""; position: absolute; left: -26px; top: 50%; width: 8px; height: 8px; margin-top: -4px; transform: rotate(45deg); background: var(--bg2); border: 2px solid var(--line); }
  .capa:hover { color: var(--ink); border-left-color: color-mix(in srgb, var(--acc) 50%, var(--line)); }
  .capa:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }
  .capa[aria-selected="true"] { color: var(--ink); border-left-color: var(--acc); background: color-mix(in srgb, var(--acc) 12%, var(--bg)); }
  .capa[aria-selected="true"]::before { background: var(--acc); border-color: var(--acc); }
  .capa .n { font: 500 .74rem/1 var(--f-m); color: var(--acc); }
  .capa .t { font: 600 clamp(.9rem, .8rem + .35vw, 1.1rem)/1.15 var(--f-b); }
  .dets { display: grid; }
  .det { display: grid; gap: 8px; align-content: start; }
  .det + .det { margin-top: 20px; }
  h4 { margin: 0; font-size: clamp(1.2rem, .9rem + 1vw, 1.7rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 600; }
  .det p { color: var(--muted); font-size: .95rem; line-height: 1.5; }
  .det li { position: relative; padding: 7px 0 7px 22px; border-top: 1px solid var(--line); font-size: .92rem; line-height: 1.4; }
  .det li::before, .queda li::before, .puntos li::before { content: "◆"; position: absolute; left: 2px; color: var(--acc); font-size: .65em; top: calc(7px + .45em); }
  :global(.js) .det { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transform: translateX(14px); transition: opacity .35s, transform .45s cubic-bezier(.2, .7, .2, 1), visibility .35s; }
  :global(.js) .det[data-on] { opacity: 1; visibility: visible; transform: none; }

  /* 2 · laboratorio */
  .ruta { position: relative; margin-top: clamp(14px, 3vh, 28px); }
  .etapas { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .linea { position: absolute; left: 4%; right: 4%; top: 50%; height: 2px; background: repeating-linear-gradient(90deg, var(--line) 0 8px, transparent 8px 14px); }
  .ruta .pulso { position: absolute; top: -3px; left: 0; width: 8px; height: 8px; background: var(--acc); animation: recorre 4.5s linear infinite; }
  @keyframes recorre { from { left: 0; } to { left: 100%; } }
  .etapa { position: relative; z-index: 1; display: grid; gap: 6px; align-content: center; min-height: clamp(74px, 13vh, 120px); padding: 12px; background: var(--bg);
    border-left: 2px solid var(--line); animation: late 4.5s linear infinite; animation-delay: calc(var(--d) * .9s); }
  @keyframes late { 0%, 12%, 100% { border-left-color: var(--line); } 4% { border-left-color: var(--acc); } }
  .etapa.origen { background: color-mix(in srgb, var(--acc) 16%, var(--bg)); border-left-color: var(--acc); animation: none; }
  .etapa .n { font: 500 .68rem/1 var(--f-m); color: var(--acc); letter-spacing: .08em; }
  .etapa .t { font: 600 clamp(.85rem, .75rem + .35vw, 1.05rem)/1.15 var(--f-b); }
  .puntos { margin-top: clamp(12px, 2.6vh, 24px); display: grid; }
  .puntos li, .queda li { position: relative; padding: 8px 0 8px 22px; border-top: 1px solid var(--line); line-height: 1.4; }
  .puntos li::before, .queda li::before { top: calc(8px + .45em); }

  /* 3 · operación y ciclo */
  .queda { margin-top: 12px; display: grid; }
  .ciclo { display: grid; grid-template-columns: auto 1fr; gap: clamp(28px, 3vw, 48px); align-items: center; margin-top: clamp(20px, 4vh, 40px); padding: 14px; }
  .ciclo p { color: var(--muted); line-height: 1.5; }
  .aro { position: relative; width: clamp(110px, 11vw, 150px); aspect-ratio: 1; border: 2px dashed var(--line); transform: rotate(45deg); margin: 18px; }
  .aro .p { position: absolute; display: grid; justify-items: center; gap: 4px; transform: translate(-50%, -50%) rotate(-45deg); font: 500 .7rem/1 var(--f-m); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .aro .p i { width: 12px; height: 12px; transform: rotate(45deg); background: var(--bg2); border: 2px solid var(--acc); }
  .p0 { left: 0; top: 0; } .p1 { left: 100%; top: 0; } .p2 { left: 100%; top: 100%; } .p3 { left: 0; top: 100%; }
  .p3 i { background: var(--acc); }
  .aro .pulso { position: absolute; width: 8px; height: 8px; margin: -5px; background: var(--sin); animation: vuelta 5s linear infinite; }
  @keyframes vuelta { 0% { left: 0; top: 0; } 25% { left: 100%; top: 0; } 50% { left: 100%; top: 100%; } 75% { left: 0; top: 100%; } 100% { left: 0; top: 0; } }

  /* los impulsos solo corren en el panel que se ve */
  :global(.js) .fase:not(.active) :is(.impulso, .pulso, .etapa) { animation-play-state: paused; }

  /* laptops de poca altura (1366×768, 1440×900): todo el panel cabe sin desplazar */
  @media (min-width: 901px) and (max-height: 820px) {
    :global(.js) .fase { padding-block: clamp(14px, 2.6vh, 32px); }
    .fase > .wrap { gap: clamp(14px, 2.6vh, 32px); }
    .pasos { gap: clamp(12px, 2.4vh, 24px); }
    .paso { gap: 6px; }
    h3 { font-size: clamp(1.4rem, .8rem + 1.6vw, 2.3rem); }
    .paso > p { font-size: .95rem; line-height: 1.5; max-width: 60ch; }
    .lleva { font-size: .9rem; line-height: 1.4; }
  }

  /* pantallas medianas: no caben los tres títulos; los inactivos quedan solo
     como nodos (su nombre sigue disponible para lectores de pantalla) */
  @media (max-width: 1100px) {
    .espina { display: flex; align-items: flex-end; }
    .tramo { flex: 1 1 24px; min-width: 24px; }
    .actual { flex: 0 1 auto; min-width: 0; }
    h2.tit { white-space: normal; text-align: center; font-size: clamp(1.6rem, 4.2vw, 2.4rem); }
    span.tit { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 760px) {
    .lema { display: none; }
  }
  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; gap: 16px; }
    .cg { grid-template-columns: 1fr; }
    .etapas { grid-template-columns: 1fr; gap: 6px; }
    .linea, .ruta .pulso { display: none; }
    .etapa { min-height: 0; grid-template-columns: auto 1fr; align-items: baseline; gap: 12px; }
    .ciclo { grid-template-columns: 1fr; justify-items: center; }
  }
  @media print {
    .modulo { display: none; }
  }
</style>

<script>
  /* mismo alto para las tres etapas: el panel centra su contenido, así que si
     una etapa es más alta que otra, todo (espina incluida) brincaría al cambiar.
     Solo en pantallas anchas; en celular el contenido ya empieza arriba. */
  const wraps = [...document.querySelectorAll<HTMLElement>(".fase > .wrap")];
  const ancho = matchMedia("(min-width: 901px)");
  const igualar = () => {
    wraps.forEach((w) => (w.style.minHeight = ""));
    if (!ancho.matches) return;
    const h = Math.max(...wraps.map((w) => w.offsetHeight));
    wraps.forEach((w) => (w.style.minHeight = `${h}px`));
  };
  /* títulos de la espina a todo el ancho: mide los tres a su tamaño actual y
     escala la letra para que llenen la fila (tope 3rem, para no quitar alto en laptops). Las tres espinas son
     iguales, así que se mide la primera y se aplica a todas. */
  const espinas = [...document.querySelectorAll<HTMLElement>(".fase .espina")];
  const fila = matchMedia("(min-width: 1101px)");
  const llenar = () => {
    espinas.forEach((e) => e.style.removeProperty("--tit"));
    const e = espinas[0];
    if (!e || !fila.matches) return;
    const tits = [...e.querySelectorAll<HTMLElement>(".tit")];
    const t0 = parseFloat(getComputedStyle(tits[0]).fontSize);
    const textos = tits.reduce((s, t) => s + t.offsetWidth, 0);
    const margen = [...e.querySelectorAll<HTMLElement>(".tramo")].reduce((s, g) => s + parseFloat(getComputedStyle(g).minWidth), 0);
    const tope = 3 * parseFloat(getComputedStyle(document.documentElement).fontSize);
    const t = Math.min(tope, (t0 * (e.clientWidth - margen - 4)) / textos);
    espinas.forEach((x) => x.style.setProperty("--tit", `${t.toFixed(2)}px`));
  };
  const medir = () => { llenar(); igualar(); };
  medir();
  addEventListener("resize", medir);
  document.fonts?.ready.then(medir);

  const sec = document.querySelector<HTMLElement>(".fase-0 .capas");
  if (sec) {
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const dets = [...sec.querySelectorAll<HTMLElement>(".det")];
    const idx = (t: HTMLElement) => Number(t.id.split("-").pop());
    const pick = (i: number, focus = false) => {
      tabs.forEach((t) => { const on = idx(t) === i; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      dets.forEach((d, k) => d.toggleAttribute("data-on", k === i));
    };
    tabs.forEach((t) => {
      t.addEventListener("click", () => pick(idx(t)));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowUp" ? 1 : e.key === "ArrowDown" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        pick((idx(t) + d + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
