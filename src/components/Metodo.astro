---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = content[lang].method;
---
<section class="block wrap" id="metodo">
  <header class="sec-h"><span class="num">I</span><div><h2>{m.title}</h2><p>{m.intro}</p></div></header>
  <div class="method">
    {m.items.map((it) => (
      <article>
        <span class="ord">{it.ord}</span>
        <h3>{it.title}</h3>
        <p>{it.body}</p>
        <blockquote>{it.quote}</blockquote>
      </article>
    ))}
  </div>
</section>

<style>
  .method { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  article { padding: 24px 24px 8px 0; display: grid; gap: 12px; align-content: start; }
  article + article { padding-left: 24px; border-left: 1px solid var(--rule); }
  .ord { font: italic 400 1.4rem var(--f-d); color: var(--seal); }
  h3 { font-size: 1.9rem; line-height: 1.05; }
  p { color: var(--muted); font-size: .98rem; }
  blockquote { margin: 6px 0 0; padding-left: 14px; border-left: 2px solid var(--seal); font: italic 400 1.15rem/1.4 var(--f-d); }
  @media (max-width: 900px) {
    .method { grid-template-columns: 1fr; }
    article + article { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>
