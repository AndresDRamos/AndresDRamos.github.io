---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const f = c.fieldNames;
const first = c.figs[0];
---
<div class="wrap" id="cifras">
  <div class="figs" role="group" aria-label={c.ui.figsLabel}>
    {c.figs.map((g, i) => (
      <button class="fig" type="button" aria-pressed={i === 0 ? "true" : "false"} aria-controls="ledger"
        data-def={g.def} data-src={g.src} data-how={g.how} data-when={g.when} data-verdict={g.verdict}>
        <span class="n">{g.n}<sup>{i + 1}</sup></span>
        <span class="l">{g.label}</span>
      </button>
    ))}
  </div>
  <div class="ledger" id="ledger" aria-live="polite">
    <span class="tag">{c.ui.ledger}</span>
    <dl>
      <dt>{f.def}</dt><dd data-k="def">{first.def}</dd>
      <dt>{f.src}</dt><dd data-k="src">{first.src}</dd>
      <dt>{f.how}</dt><dd data-k="how">{first.how}</dd>
      <dt>{f.when}</dt><dd data-k="when">{first.when}</dd>
    </dl>
    <span class="verdict" data-k="verdict">{first.verdict}</span>
  </div>
</div>

<style>
  .figs { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .fig { all: unset; cursor: pointer; padding: 22px 20px 18px; border-left: 1px solid var(--rule); display: grid; gap: 6px; align-content: start; position: relative; }
  .fig:first-child { border-left: 0; }
  .fig:focus-visible { outline: 2px solid var(--seal); outline-offset: -2px; }
  .n { font: 400 clamp(2.6rem, 5vw, 3.8rem)/1 var(--f-d); }
  sup { font: 500 .7rem var(--f-m); color: var(--seal); vertical-align: top; margin-left: 4px; position: relative; top: .6em; }
  .l { font-size: .9rem; color: var(--muted); line-height: 1.4; }
  .fig::after { content: ""; position: absolute; left: 20px; right: 20px; bottom: 0; height: 3px; background: var(--seal); transform: scaleX(0); transform-origin: left; transition: transform .35s; }
  .fig[aria-pressed="true"]::after { transform: none; }
  .fig[aria-pressed="true"] .n { color: var(--seal); }

  .ledger { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: start; padding-top: 26px; min-height: 190px; }
  .tag { font: 500 .7rem var(--f-m); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); writing-mode: vertical-rl; transform: rotate(180deg); }
  dl { margin: 0; display: grid; grid-template-columns: 120px 1fr; gap: 10px 18px; }
  dt { font: 500 .72rem var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
  dd { margin: 0; font-size: .98rem; }
  .verdict { font: 600 .78rem var(--f-m); letter-spacing: .16em; text-transform: uppercase; color: var(--ok); border: 2px solid currentColor;
    padding: 10px 14px; border-radius: 4px; transform: rotate(-6deg); white-space: nowrap; margin-top: 8px; }
  .ledger.swap dl { animation: inkin .45s ease; }
  .ledger.swap .verdict { animation: stamp2 .5s cubic-bezier(.2, 1.6, .4, 1); }
  @keyframes inkin { from { opacity: 0; transform: translateY(6px); } }
  @keyframes stamp2 { from { opacity: 0; transform: rotate(-14deg) scale(1.5); } to { transform: rotate(-6deg) scale(1); } }

  @media (max-width: 900px) {
    .figs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fig:nth-child(3) { border-left: 0; }
    .fig:nth-child(n+3) { border-top: 1px solid var(--rule); }
  }
  @media (max-width: 560px) {
    .ledger { grid-template-columns: 1fr; gap: 14px; }
    .tag { writing-mode: horizontal-tb; transform: none; }
    dl { grid-template-columns: 1fr; gap: 2px 0; }
    dd { margin-bottom: 8px; }
    .verdict { justify-self: start; }
  }
  @media print { .ledger { display: none; } .fig::after { display: none; } }
</style>

<script>
  const figs = [...document.querySelectorAll<HTMLButtonElement>(".fig")];
  const ledger = document.getElementById("ledger")!;
  const fill = (k: string, v: string) => { const el = ledger.querySelector(`[data-k="${k}"]`); if (el) el.textContent = v; };
  function show(btn: HTMLButtonElement) {
    if (btn.getAttribute("aria-pressed") === "true") return;
    figs.forEach((f) => f.setAttribute("aria-pressed", String(f === btn)));
    for (const k of ["def", "src", "how", "when", "verdict"]) fill(k, btn.dataset[k] ?? "");
    ledger.classList.remove("swap"); void ledger.offsetWidth; ledger.classList.add("swap");
  }
  figs.forEach((f) => {
    f.addEventListener("click", () => show(f));
    f.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") show(f); });
  });
</script>
