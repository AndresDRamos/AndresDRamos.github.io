---
import Seal from "./Seal.astro";
import { content, CONTACT, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const sealText = lang === "es" ? "arquitectura de datos · andcom · planeación ·" : "data architecture · andcom · plant planning ·";
---
<section class="panel contact" id="contacto" data-nav>
  <div class="wrap">
    <div class="main">
      <div class="txt">
        <span class="kicker" data-r>06 · {c.nav[c.nav.length - 1].label}</span>
        <h2 data-r style="--i:1">{c.contact.titleA} <em>{c.contact.titleEm}</em></h2>
        <p data-r style="--i:2">{c.contact.body}</p>
        <div class="cta" data-r style="--i:3">
          <a class="btn" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a class="btn ghost no-print" href={CONTACT.github} target="_blank" rel="noopener">GitHub</a>
          <button class="btn ghost no-print" type="button" id="print">{c.ui.print}</button>
        </div>
      </div>
      <div data-r="s" style="--i:2"><Seal uid="contact" text={sealText} class="seal-lg" /></div>
    </div>
    <footer><span>{c.footer.left}</span><span>{c.footer.right}</span></footer>
  </div>
</section>

<style>
  .contact { align-content: stretch; }
  .contact > .wrap { grid-template-rows: 1fr auto; }
  .main { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(24px, 5vw, 96px); align-items: center; }
  .txt { display: grid; gap: clamp(14px, 2.6vh, 28px); justify-items: start; }
  .kicker { color: var(--seal); }
  h2 { font-size: clamp(2.6rem, 1rem + 6.4vw, 7.5rem); line-height: .98; letter-spacing: -.03em; }
  h2 em { color: var(--seal); font-weight: 500; }
  .txt p { color: var(--muted); max-width: 56ch; font-size: clamp(1.05rem, .95rem + .4vw, 1.3rem); }
  .main :global(.seal-lg) { width: clamp(120px, 20vw, 300px); }
  footer { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 18px; border-top: 1px solid var(--rule); font: 500 .85rem var(--f-b); color: var(--muted); }
  @media (max-width: 760px) { .main { grid-template-columns: 1fr; } .main :global(.seal-lg) { width: 110px; } }
  @media print { .main :global(.seal-lg) { width: 90px; } h2 { font-size: 24pt; } }
</style>

<script>
  document.getElementById("print")?.addEventListener("click", () => window.print());
</script>
