---
import Seal from "./Seal.astro";
import { content, CONTACT, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const sealText = lang === "es" ? "datos con evidencia · andcom · planeación auditable ·" : "data with evidence · andcom · auditable planning ·";
---
<div class="wrap">
  <section class="origin block" aria-label={lang === "es" ? "Origen" : "Background"}>
    <p class="big">{c.origin.lead}<em>{c.origin.em}</em>{c.origin.rest}</p>
    <small>{c.origin.small}</small>
  </section>

  <div class="notes" aria-label={lang === "es" ? "Notas de las cifras" : "Figure notes"}>
    {c.notes.map((n) => <p>{n}</p>)}
  </div>

  <section class="contact" id="contacto">
    <div>
      <h2>{c.contact.titleA} <em>{c.contact.titleEm}</em></h2>
      <p>{c.contact.body}</p>
      <div class="cta">
        <a class="btn" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <a class="btn ghost no-print" href={CONTACT.github} target="_blank" rel="noopener">GitHub</a>
        <button class="btn ghost no-print" type="button" id="print">{c.ui.print}</button>
      </div>
    </div>
    <Seal uid="contact" text={sealText} class="seal-lg" />
  </section>

  <footer><span>{c.footer.left}</span><span>{c.footer.right}</span></footer>
</div>

<style>
  .origin { max-width: 900px; }
  .big { font: 400 clamp(1.6rem, 3vw, 2.4rem)/1.3 var(--f-d); }
  .big em { color: var(--seal); }
  small { display: block; margin-top: 18px; color: var(--muted); font-size: .95rem; }
  .notes { margin-top: 64px; padding-top: 16px; border-top: 1px solid var(--rule); display: grid; gap: 6px; font-size: .84rem; color: var(--muted); counter-reset: n; }
  .notes p { display: grid; grid-template-columns: 28px 1fr; }
  .notes p::before { counter-increment: n; content: "[" counter(n) "]"; font-family: var(--f-m); color: var(--seal); font-size: .75rem; padding-top: 2px; }
  .contact { margin-top: 88px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); padding: 56px 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: center; }
  h2 { font-size: clamp(2.4rem, 6vw, 4.4rem); line-height: 1; }
  h2 em { color: var(--seal); }
  .contact p { color: var(--muted); margin: 14px 0 26px; max-width: 52ch; }
  button.btn { cursor: pointer; }
  .contact :global(.seal-lg) { width: 170px; }
  footer { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 20px 0 40px; font: 500 .74rem var(--f-m); color: var(--muted); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } .contact :global(.seal-lg) { width: 120px; } }
  @media print { .contact { padding: 18pt 0; } .contact :global(.seal-lg) { width: 90px; } }
</style>

<script>
  document.getElementById("print")?.addEventListener("click", () => window.print());
</script>
