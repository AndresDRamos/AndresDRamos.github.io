---
/*
  Sistemas: pestañas en vez de una lista larga. En escritorio la lista queda a la
  izquierda y el detalle a la derecha; en celular las pestañas se deslizan en
  horizontal. Sin JS se muestran todos los sistemas apilados.
*/
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const x = content[lang].systems;
---
<section class="panel" id="sistemas" data-nav>
  <div class="wrap">
    <header class="sec-h" data-r>
      <span class="num">02</span>
      <h2>{x.title}</h2>
      <p>{x.intro}</p>
    </header>

    <div class="sys" data-r style="--i:1">
      <div class="tabs" role="tablist" aria-label={x.title}>
        {x.items.map((it, i) => (
          <button type="button" role="tab" id={`tab-${i}`} aria-controls={`sys-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            <span class="no">{it.id}</span>
            <span class="tt">{it.title}</span>
          </button>
        ))}
      </div>

      <div class="views">
        {x.items.map((it, i) => (
          <article class="view" role="tabpanel" id={`sys-${i}`} aria-labelledby={`tab-${i}`} data-on={i === 0 ? "" : undefined}>
            <header>
              <span class="kicker">{it.id} · {it.area}</span>
              <h3>{it.title}</h3>
            </header>
            <div class="cols rail">
              <div class="prose">
                <p><b>{x.labels.problem}</b>{it.problem}</p>
                <p><b>{x.labels.design}</b>{it.design}</p>
              </div>
              <div class="dec">
                <b>{x.labels.decisions}</b>
                <ul>{it.decisions.map((d) => <li>{d}</li>)}</ul>
              </div>
            </div>
            <ol class="flow" aria-label={x.labels.flow}>
              {it.flow.map((f) => <li>{f}</li>)}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sys { display: grid; grid-template-columns: minmax(240px, .9fr) minmax(0, 2.6fr); gap: clamp(16px, 2.4vw, 40px); align-items: stretch; }
  .tabs { display: grid; align-content: start; border-top: 1px solid var(--ink); }
  [role="tab"] { all: unset; cursor: pointer; display: grid; grid-template-columns: 52px 1fr; align-items: baseline; gap: 4px;
    padding: clamp(9px, 1.6vh, 15px) 12px clamp(9px, 1.6vh, 15px) 0; border-bottom: 1px solid var(--rule); position: relative; transition: padding .3s, color .2s; color: var(--muted); }
  [role="tab"]::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--seal); transform: scaleY(0); transition: transform .3s; }
  [role="tab"]:hover { color: var(--ink); }
  [role="tab"][aria-selected="true"] { color: var(--ink); padding-left: 16px; }
  [role="tab"][aria-selected="true"]::before { transform: none; }
  [role="tab"]:focus-visible { outline: 2px solid var(--seal); outline-offset: -2px; }
  .no { font: 500 .8rem var(--f-m); color: var(--seal); }
  .tt { font: 600 1rem/1.25 var(--f-b); }

  .views { display: grid; }
  .view { background: var(--paper); border: 1px solid var(--rule); border-radius: 10px; padding: clamp(18px, 3vh, 34px) clamp(18px, 2.4vw, 40px);
    display: grid; gap: clamp(14px, 2.4vh, 26px); align-content: space-between; }
  .view + .view { margin-top: 16px; }
  .view header { display: grid; gap: 8px; }
  .view .kicker { color: var(--seal); }
  h3 { font-size: clamp(1.45rem, 1rem + 1.2vw, 2.2rem); line-height: 1.08; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(18px, 3vw, 56px); }
  .prose { display: grid; gap: 14px; align-content: start; }
  .cols { font-size: .96rem; line-height: 1.5; }
  b { display: block; font: 600 .8rem/1.3 var(--f-b); letter-spacing: .09em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .dec li { position: relative; padding: clamp(6px, 1.1vh, 10px) 0 clamp(6px, 1.1vh, 10px) 26px; border-top: 1px solid var(--rule); line-height: 1.45; }
  .dec li::before { content: ""; position: absolute; left: 2px; top: calc(clamp(6px, 1.1vh, 10px) + .5em); width: 10px; height: 2px; background: var(--seal); }
  /* flujo: entradas → proceso → salida */
  .flow { list-style: none; margin: 0; padding: clamp(12px, 2vh, 20px) 0 0; border-top: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 26px; }
  .flow li { position: relative; font: 500 .88rem/1.35 var(--f-m); padding: 10px 12px; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg); }
  .flow li:last-child { border-color: var(--seal); color: var(--seal); }
  .flow li + li::before { content: "→"; position: absolute; left: -21px; top: 50%; transform: translateY(-50%); color: var(--seal); font-family: var(--f-b); }

  /* con JS: una vista a la vez, con transición */
  :global(.js) .view { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transform: translateY(18px); transition: opacity .35s, transform .45s cubic-bezier(.2, .7, .2, 1), visibility .35s; }
  :global(.js) .view[data-on] { opacity: 1; visibility: visible; transform: none; }
  :global(.js) .view[data-on] .flow li { animation: chip-in .5s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--k, 0) * 90ms + 150ms); }
  @keyframes chip-in { from { opacity: 0; transform: translateX(-14px); } }

  @media (max-width: 980px) {
    .sys { grid-template-columns: 1fr; gap: 14px; }
    .tabs { display: flex; gap: 8px; border: 0; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity;
      margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
    .tabs::-webkit-scrollbar { display: none; }
    [role="tab"], [role="tab"][aria-selected="true"] { display: block; flex: none; padding: 9px 14px; border: 1px solid var(--rule); border-radius: 999px; scroll-snap-align: start; white-space: nowrap; }
    [role="tab"]::before { display: none; }
    [role="tab"][aria-selected="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    [role="tab"] .no { display: none; }
    .tt { font-size: .92rem; }
    .view { padding: 14px 16px; gap: 12px; }
    h3 { font-size: 1.3rem; }
    .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 22px; }
    .flow li:nth-child(3)::before { display: none; }
    .flow li { font-size: .8rem; padding: 8px 10px; }
    .flow li + li::before { left: -18px; }
    .prose, .dec li { font-size: .92rem; }
    .prose { gap: 10px; }
    .dec li { padding-top: 6px; padding-bottom: 6px; }
    .flow { padding-top: 10px; }
  }
  /* la regla .rail global usa el margen de página; aquí el carrusel vive dentro de la tarjeta */
  @media (max-width: 760px) {
    .cols.rail { margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px; grid-auto-columns: 92%; }
  }
  @media (min-width: 761px) and (max-width: 980px) { .cols { grid-template-columns: 1fr 1fr; gap: 20px; } }
  @media print {
    .tabs { display: none; }
    .view { opacity: 1 !important; visibility: visible !important; transform: none !important; grid-area: auto !important; break-inside: avoid; border: 0; border-top: 1px solid var(--rule); border-radius: 0; padding: 8pt 0; }
  }
</style>

<script>
  const sys = document.querySelector<HTMLElement>(".sys");
  if (sys) {
    const tabs = [...sys.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const views = [...sys.querySelectorAll<HTMLElement>(".view")];
    views.forEach((v) => v.querySelectorAll<HTMLElement>(".flow li").forEach((li, k) => li.style.setProperty("--k", String(k))));
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      views.forEach((v, k) => v.toggleAttribute("data-on", k === i));
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: "nearest", inline: "center", behavior: "smooth" });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => pick(i));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        pick((i + d + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
