---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const o = content[lang].offer;
---
<section class="panel" id="servicios" data-nav>
  <div class="wrap">
    <header class="sec-h" data-r>
      <span class="num">04</span>
      <h2>{o.title}</h2>
      <p>{o.intro}</p>
    </header>
    <div class="offer rail">
      {o.items.map((it, i) => (
        <article class="card" data-r style={`--i:${i + 1}`}>
          <span class="kicker">{it.kicker}</span>
          <h3>{it.title}</h3>
          <p>{it.body}</p>
          <ul>{it.list.map((li) => <li>{li}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .offer { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 28px); }
  .card { background: var(--paper); border: 1px solid var(--rule); border-radius: 10px; padding: clamp(20px, 3.6vh, 40px) clamp(18px, 2.2vw, 36px);
    display: grid; gap: clamp(10px, 1.8vh, 18px); align-content: start; }
  .card:hover { border-color: var(--ink); }
  .kicker { color: var(--seal); }
  h3 { font-size: clamp(1.5rem, 1rem + 1.3vw, 2.3rem); line-height: 1.08; }
  p { color: var(--muted); }
  ul { margin: 0; padding: clamp(12px, 2vh, 18px) 0 0; list-style: none; display: grid; gap: 10px; border-top: 1px solid var(--rule); }
  li { display: grid; grid-template-columns: 22px 1fr; gap: 6px; line-height: 1.4; }
  li::before { content: "✓"; color: var(--ok); font-weight: 700; }
</style>
